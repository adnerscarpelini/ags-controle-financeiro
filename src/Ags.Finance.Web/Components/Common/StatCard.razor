@* Total sem caixa e sem ícone: rótulo com ajuda opcional e valor. O valor aparece como veio do caso de uso. *@
<div class="stat-card stat-@Tone @(Hero ? "stat-hero" : null)" data-stat="@Testid">
    <div class="stat-text">
        <span class="stat-label">@Label @if (Help is not null) { <HelpTip Text="@Help" /> }</span>
        <span class="stat-value">@Value</span>
        @if (Note is not null) { <small class="stat-note">@Note</small> }
    </div>
</div>

@code {
    /// <summary>accent e expense ficam neutros; income é verde; warning e danger sinalizam alerta.</summary>
    [Parameter]
    public string Tone { get; set; } = "accent";

    /// <summary>O total principal da tela, em tamanho maior.</summary>
    [Parameter]
    public bool Hero { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string? Help { get; set; }

    [Parameter, EditorRequired]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? Note { get; set; }

    [Parameter]
    public string? Testid { get; set; }
}
