@* Campo de valor em reais: formato pt-BR enquanto se digita (wwwroot/js/money-mask.js) e teclado numérico no celular. *@
@using System.Globalization

<div class="money-field @Class" data-money-allow-negative="@(Min < 0)">
    <label for="@Id">@Label</label>
    <MudTextField @ref="_field" T="string" InputId="@Id" Value="_text" ValueChanged="TextChangedAsync" Immediate="true" InputMode="DecimalMode" Variant="Variant.Text"
                  Adornment="Adornment.Start" AdornmentText="R$" AutoFocus="AutoFocus" Disabled="Disabled" />
</div>

@code {
    private const InputMode DecimalMode = InputMode.@decimal;
    private static readonly CultureInfo s_culture = CultureInfo.GetCultureInfo("pt-BR");
    private MudTextField<string>? _field;
    private string _text = Format(0);
    private decimal _shown;

    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = "Valor";

    [Parameter]
    public decimal Value { get; set; }

    [Parameter]
    public EventCallback<decimal> ValueChanged { get; set; }

    [Parameter]
    public decimal Min { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool AutoFocus { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    public async Task FocusAsync()
    {
        if (_field is not null)
        {
            await _field.FocusAsync();
        }
    }

    protected override void OnParametersSet()
    {
        if (Value != _shown)
        {
            _shown = Value;
            _text = Format(Value);
        }
    }

    private async Task TextChangedAsync(string? text)
    {
        _text = text ?? string.Empty;
        _shown = Math.Max(Parse(_text), Min);
        await ValueChanged.InvokeAsync(_shown);
    }

    private static string Format(decimal value) => value.ToString("N2", s_culture);

    private static decimal Parse(string text) => decimal.TryParse(text, NumberStyles.Number, s_culture, out var value) ? value : 0;
}
