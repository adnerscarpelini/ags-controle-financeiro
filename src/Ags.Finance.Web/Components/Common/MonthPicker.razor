@* Seletor de mês: < Novembro de 2026 >. *@
@using System.Globalization
@using Ags.Finance.SharedKernel

<div class="month-picker" role="group" aria-label="Mês">
    <MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft" aria-label="@PreviousLabel" data-month-previous Disabled="Disabled" OnClick="() => ValueChanged.InvokeAsync(Value.AddMonths(-1))" />
    <strong data-month-label aria-live="polite">@Label(Value)</strong>
    <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" aria-label="@NextLabel" data-month-next Disabled="Disabled" OnClick="() => ValueChanged.InvokeAsync(Value.AddMonths(1))" />
</div>

@code {
    private static readonly CultureInfo s_culture = CultureInfo.GetCultureInfo("pt-BR");

    [Parameter, EditorRequired]
    public ReferenceMonth Value { get; set; }

    [Parameter]
    public EventCallback<ReferenceMonth> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string PreviousLabel { get; set; } = "Mês anterior";

    [Parameter]
    public string NextLabel { get; set; } = "Próximo mês";

    public static string Label(ReferenceMonth month)
    {
        var text = month.FirstDay.ToString("MMMM 'de' yyyy", s_culture);
        return char.ToUpper(text[0], s_culture) + text[1..];
    }
}
