@using Ags.Finance.Modules.Preferences.Contracts
@inject IPreferences Preferences
@inject ILogger<App> Logger
<!DOCTYPE html>
<html lang="pt-BR" data-theme="@ThemeName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Finanças" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="img/apple-touch-icon.png" />
    <base href="/" />
    <link rel="icon" type="image/png" sizes="64x64" href="img/favicon.png" />
    <link rel="preload" href="fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    @if (PageRenderMode is not null)
    {
        <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    }
    <link rel="stylesheet" href="css/tokens.css" />
    <link rel="stylesheet" href="css/app.css" />
    <script src="js/privacy.js"></script>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
    @if (PageRenderMode is not null)
    {
        <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    }
    <script src="js/viewport.js"></script>
    <script src="js/keyboard-shortcuts.js"></script>
    <script src="js/pwa.js"></script>
    <script src="js/theme.js"></script>
    <script src="js/pickers.js"></script>
    <script src="js/logo-crop.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string ThemeName { get; set; } = "dark";

    // O tema escolhido já sai no HTML inicial (também no login), para a página não piscar no tema errado.
    // Sem conseguir ler a preferência, vale o tema escuro.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            ThemeName = (await Preferences.GetAsync(HttpContext.RequestAborted)).Theme switch
            {
                ThemePreference.Light => "light",
                ThemePreference.Auto => "auto",
                _ => "dark",
            };
        }
        catch (Exception exception) when (exception is Npgsql.NpgsqlException or InvalidOperationException or OperationCanceledException)
        {
            Logger.LogWarning(exception, "Não foi possível ler o tema; usando o escuro.");
        }
    }

    // A página de login é renderizada só no servidor, sem circuito: ela precisa de uma requisição HTTP comum
    // para o cookie de sessão ser emitido. As demais rodam interativas.
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
