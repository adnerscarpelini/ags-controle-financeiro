@* Transferências recorrentes do mês na tela de Contas. Só aparece quando existe alguma série. *@
@using Ags.Finance.Modules.Accounts.Contracts
@using Ags.Finance.Modules.Transactions.Contracts
@using Ags.Finance.SharedKernel
@using Ags.Finance.Web.Components.Entries
@implements IDisposable
@inject IRecurringTransferCatalog Transfers
@inject IAccountCatalog Accounts
@inject EntryChangeNotifier EntryChanges
@inject TimeProvider Clock

@if (_hasSeries)
{
    <section class="panel recurring-transfers" aria-labelledby="recurring-transfers-title" data-recurring-transfers>
        <div class="panel-head">
            <h2 id="recurring-transfers-title">Transferências recorrentes <HelpTip Text="Cada mês fica pendente até você confirmar: só então as duas contas são movimentadas. Pendentes entram no saldo previsto." /></h2>
            <MonthPicker Value="_month" ValueChanged="MonthChangedAsync" />
        </div>
        @if (_error is not null) { <p class="form-error" role="alert">@_error</p> }
        @if (_occurrences.Count == 0)
        {
            <p>Nenhuma transferência recorrente neste mês.</p>
        }
        else
        {
            <ul class="recurring-transfer-list" aria-label="Transferências recorrentes do mês">
                @foreach (var occurrence in _occurrences)
                {
                    <li data-recurring-transfer="@occurrence.ExternalId">
                        <div class="recurring-transfer-text">
                            <span class="recurring-transfer-accounts">@Name(occurrence.SourceAccountExternalId) → @Name(occurrence.DestinationAccountExternalId)</span>
                            <small class="form-note">@occurrence.Date.ToString("dd/MM/yyyy") · @(occurrence.IsConfirmed ? "Confirmada" : Overdue(occurrence) ? "Atrasada" : "Pendente")</small>
                        </div>
                        <span class="numeric value-neutral" data-recurring-transfer-amount>@occurrence.Amount</span>
                        <RecurringTransferActions Occurrence="occurrence" Summary="@Summary(occurrence)" ErrorChanged="error => _error = error" />
                    </li>
                }
            </ul>
        }
    </section>
}

@code {
    private IReadOnlyList<RecurringTransferOccurrence> _occurrences = [];
    private IReadOnlyList<AccountDetails> _accounts = [];
    private ReferenceMonth _month;
    private bool _hasSeries;
    private string? _error;

    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    protected override async Task OnInitializedAsync()
    {
        EntryChanges.Changed += EntriesChangedAsync;
        _month = ReferenceMonth.FromDate(Today);
        await ReloadAsync();
    }

    private Task EntriesChangedAsync() => InvokeAsync(async () =>
    {
        await ReloadAsync();
        StateHasChanged();
    });

    private async Task MonthChangedAsync(ReferenceMonth month)
    {
        _month = month;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _hasSeries = await Transfers.HasSeriesAsync();
        _accounts = await Accounts.GetAccountsAsync(false);
        _occurrences = _hasSeries ? await Transfers.GetMonthAsync(_month) : [];
    }

    private string Name(Guid id) => _accounts.FirstOrDefault(x => x.ExternalId == id)?.Name ?? "Conta registrada";

    private bool Overdue(RecurringTransferOccurrence occurrence) => occurrence.Date < Today;

    private string Summary(RecurringTransferOccurrence occurrence)
        => $"{Name(occurrence.SourceAccountExternalId)} → {Name(occurrence.DestinationAccountExternalId)} · {occurrence.Date:dd/MM/yyyy} · {occurrence.Amount}";

    public void Dispose() => EntryChanges.Changed -= EntriesChangedAsync;
}
