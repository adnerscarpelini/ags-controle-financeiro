@* Ajuste de total em dois passos: a diferença vira um lançamento no mês da fatura, sem alterar compras nem pagamentos. *@
@using Ags.Finance.Modules.Invoices.Contracts
@using Ags.Finance.SharedKernel
@inject IInvoiceAdjustmentCatalog Adjustments
@inject EntryChangeNotifier Notifier
@inject ISnackbar Snackbar

<MudDialog Class="app-dialog">
    <DialogContent>
        <div class="entry-column" aria-label="Ajustar total da fatura">
            <p class="form-note">Total bruto lançado até hoje: @Invoice.LaunchedTotal · Saldo restante após abatimentos: @Invoice.RemainingBalance</p>
            @if (Invoice.ForecastEntries.Count > 0) { <p class="form-note invoice-forecast">As recorrentes previstas (@Invoice.ForecastTotal) ainda não foram cobradas pelo banco e ficam fora desta comparação.</p> }
            <p class="form-note">Informe o total bruto correto. A diferença será um ajuste de despesa no mês da fatura, sem alterar compras, pagamentos ou débitos em conta.</p>
            @if (_error is not null) { <p class="form-error" role="alert" data-entry-error>@_error</p> }
            @if (_confirmation is { } confirmation)
            {
                <dl class="review-list" data-adjustment-review>
                    <div><dt>Total lançado até hoje</dt><dd>@Invoice.LaunchedTotal</dd></div>
                    <div><dt>Total informado</dt><dd>@confirmation.CorrectTotal</dd></div>
                    <div><dt>Diferença</dt><dd>@(confirmation.CorrectTotal - Invoice.LaunchedTotal)</dd></div>
                </dl>
                <p class="form-note">O ajuste será registrado na data da confirmação e preservará o mês de referência da fatura. Correções são novos ajustes.</p>
            }
            else
            {
                <form id="invoice-adjustment-form" @onsubmit="Review" @onsubmit:preventDefault>
                    <MoneyField Id="invoice-correct-total" Label="Total bruto correto" @bind-Value="_correctTotal" Min="decimal.MinValue" AutoFocus="true" />
                </form>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton data-dialog-cancel Disabled="@_busy" OnClick="() => Dialog?.Cancel()">Cancelar</MudButton>
        @if (_confirmation is not null)
        {
            <MudButton data-review-back Disabled="@_busy" OnClick="() => _confirmation = null">Voltar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" data-confirm-ok Disabled="@_busy" OnClick="ConfirmAsync">Confirmar ajuste de fatura</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" form="invoice-adjustment-form" data-review Disabled="@_busy">Revisar ajuste</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    [Parameter, EditorRequired]
    public InvoiceDetails Invoice { get; set; } = default!;

    private readonly Guid _confirmationId = Guid.CreateVersion7();
    private decimal _correctTotal;
    private bool _busy;
    private string? _error;
    private AdjustInvoiceTotalRequest? _confirmation;

    protected override void OnInitialized() => _correctTotal = Invoice.LaunchedTotal.Amount;

    private void Review() => _confirmation = new(_confirmationId, Invoice.CardExternalId, Invoice.Month, new Money(_correctTotal), Invoice.LaunchedTotal);

    private async Task ConfirmAsync()
    {
        if (_busy || _confirmation is not { } request) { return; }
        _busy = true;
        try
        {
            var result = await Adjustments.AdjustTotalAsync(request);
            _error = result.Error;
            if (result.Succeeded)
            {
                Notifier.Notify();
                Snackbar.Add("Total conferido e atualizado.", Severity.Success);
                Dialog?.Close(DialogResult.Ok(true));
            }
        }
        finally { _busy = false; }
    }
}
