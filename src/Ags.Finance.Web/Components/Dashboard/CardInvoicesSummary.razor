@* Faturas a pagar na posição de hoje (issue 144): Fechadas com saldo e a Aberta atual de cada cartão, sem depender de mês.
   Em destaque, o que falta pagar; abaixo, o total gasto e o abatido. Cartão arquivado continua enquanto tiver fatura a pagar (#53). *@
@using System.Globalization
@using Ags.Finance.Modules.Accounts.Contracts
@using Ags.Finance.Modules.Invoices.Contracts
@using Ags.Finance.SharedKernel
@using Ags.Finance.Web.Components.Pages
@inject IAccountCatalog Accounts
@inject IInvoiceCatalog Invoices
@inject TimeProvider Clock

<section class="panel summary-panel" aria-labelledby="card-invoices-title">
    <h2 id="card-invoices-title"><span class="heading-icon heading-icon-expense" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.CreditCard" /></span>Faturas a pagar <HelpTip Text="O que falta pagar das faturas Abertas atuais e das Fechadas ainda não pagas: total gasto menos pagamentos, antecipações, cashback e descontos. Faturas pagas e parcelas de meses futuros não aparecem." /></h2>
    @if (_rows is { } rows)
    {
        <strong class="numeric summary-hero @ValueColor.Owed(Sum(rows))" data-invoices-total>@Sum(rows)</strong>
        @if (rows.Count == 0)
        {
            <p data-no-payable>Nenhuma fatura a pagar.</p>
        }
        else
        {
            <ul class="summary-list" aria-label="Faturas a pagar">
                @foreach (var row in rows)
                {
                    <li class="summary-item" data-card-invoice="@row.Invoice.CardName" data-invoice-month="@row.Invoice.Month">
                        <div class="summary-head">
                            @if (row.Bank is not null) { <BankLogo Bank="row.Bank" /> }
                            <div class="summary-title">
                                <span><a class="summary-name" href="@InvoiceDetail.Url(row.Invoice.CardExternalId, row.Invoice.Month)">@row.Invoice.CardName</a>@(row.Archived ? " (arquivado)" : null) <span class="tag @StatusClass(row.Invoice.Status)" data-invoice-status>@StatusLabel(row.Invoice.Status)</span></span>
                                @if (row.Dates is { } dates)
                                {
                                    <span class="row-note">
                                        @* Depois do corte e antes do fechamento automático, a fatura ainda é Aberta, mas a data de fechamento já passou: não a anuncia. *@
                                        @if (row.Invoice.Status == InvoiceStatus.Open && dates.ClosingDate >= _today) { <span>Fecha em @dates.ClosingDate.ToString("dd/MM", s_culture) · </span> }
                                        <span class="@(dates.DueDate < _today ? ValueColor.Negative : null)" data-invoice-due>@(dates.DueDate < _today ? "Venceu em" : "Vence em") @dates.DueDate.ToString("dd/MM/yyyy", s_culture)</span>
                                    </span>
                                }
                            </div>
                            <div class="summary-amounts">
                                <span class="numeric summary-value @ValueColor.Owed(row.Invoice.RemainingBalance)" data-invoice-remaining>@row.Invoice.RemainingBalance</span>
                                <span class="summary-breakdown-line">Total <span data-invoice-total>@row.Invoice.Total</span>@if (!row.Deductions.IsZero) { <span> · abatido <span data-invoice-deductions>@row.Deductions</span></span> }</span>
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
        <a class="summary-link" href="cartoes">Ver cartões</a>
    }
</section>

@code {
    private static readonly CultureInfo s_culture = CultureInfo.GetCultureInfo("pt-BR");

    private sealed record Row(InvoiceDetails Invoice, BankDetails? Bank, InvoiceDates? Dates, bool Archived)
    {
        public Money Deductions => Invoice.Total - Invoice.RemainingBalance;
    }

    private IReadOnlyList<Row>? _rows;
    private DateOnly _today;

    protected override async Task OnInitializedAsync()
    {
        _today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        var banks = await Accounts.GetBanksAsync();
        var accounts = await Accounts.GetAccountsAsync(activeOnly: false);
        var cards = await Accounts.GetCreditCardsAsync(activeOnly: false);
        var rows = new List<Row>();
        foreach (var invoice in await Invoices.GetPayableAsync())
        {
            var card = cards.FirstOrDefault(x => x.ExternalId == invoice.CardExternalId);
            var account = accounts.FirstOrDefault(x => x.ExternalId == card?.AccountExternalId);
            rows.Add(new Row(
                invoice,
                banks.FirstOrDefault(x => x.ExternalId == account?.BankExternalId),
                await Invoices.GetDatesAsync(invoice.CardExternalId, invoice.Month),
                card is { IsAvailable: false }));
        }

        _rows = rows;
    }

    private static Money Sum(IEnumerable<Row> rows) => new(rows.Sum(x => x.Invoice.RemainingBalance.Amount));

    private static string StatusLabel(InvoiceStatus status) => status == InvoiceStatus.Closed ? "Fechada" : "Aberta";

    private static string StatusClass(InvoiceStatus status) => status == InvoiceStatus.Closed ? "tag-closed" : "tag-open";
}
