@using Ags.Finance.Modules.Reports.Contracts
@inject IPendingAgenda Agenda

@if (_agenda is { } agenda)
{
    <section class="panel" aria-labelledby="pending-title">
        <h2 id="pending-title">Próximos @agenda.WindowDays dias</h2>
        <p>De @agenda.Today.ToString("dd/MM/yyyy") até @agenda.WindowEnd.ToString("dd/MM/yyyy"), pela data prevista. É previsão: não altera o saldo efetivo das contas.</p>
        <dl class="metric-grid">
            <div class="metric"><dt>A receber</dt><dd class="numeric entry-income">@agenda.Upcoming.ToReceive</dd></div>
            <div class="metric"><dt>A pagar</dt><dd class="numeric entry-expense">@Negative(agenda.Upcoming.ToPay)</dd></div>
        </dl>
        <PendingList Items="agenda.Upcoming.Items" Empty="@($"Nenhuma pendência nos próximos {agenda.WindowDays} dias.")" Label="@($"Pendências dos próximos {agenda.WindowDays} dias")" />
        <h3>Atrasados</h3>
        <p>Data prevista anterior a hoje; não entram nos totais acima.</p>
        <dl class="metric-grid">
            <div class="metric"><dt>Atrasado a receber</dt><dd class="numeric entry-income">@agenda.Overdue.ToReceive</dd></div>
            <div class="metric"><dt>Atrasado a pagar</dt><dd class="numeric entry-expense">@Negative(agenda.Overdue.ToPay)</dd></div>
        </dl>
        <PendingList Items="agenda.Overdue.Items" Empty="Nenhuma pendência atrasada." Label="Pendências atrasadas" />
        <p><a href="/pendentes">Ver todas as pendências</a></p>
    </section>
}

@code {
    private PendingAgenda? _agenda;

    protected override async Task OnInitializedAsync() => _agenda = await Agenda.GetAsync();

    private static Ags.Finance.SharedKernel.Money Negative(Ags.Finance.SharedKernel.Money value) => value.IsZero ? value : -value;
}
