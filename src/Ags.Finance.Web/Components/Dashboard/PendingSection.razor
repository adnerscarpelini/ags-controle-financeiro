@using Ags.Finance.Modules.Reports.Contracts
@inject IPendingAgenda Agenda

@if (_agenda is { } agenda)
{
    <div class="dashboard-columns">
    <section class="panel" aria-labelledby="pending-title">
        <h2 id="pending-title">Próximos @agenda.WindowDays dias <HelpTip Text="@($"De {agenda.Today:dd/MM/yyyy} até {agenda.WindowEnd:dd/MM/yyyy}, pela data prevista. É previsão: não altera o saldo efetivo das contas.")" /></h2>
        <div class="stat-cards">
            <StatCard ValueClass="@ValueColor.Income(agenda.Upcoming.ToReceive)" Label="A receber" Value="@agenda.Upcoming.ToReceive.ToString()" Testid="to-receive" />
            <StatCard ValueClass="@ValueColor.Expense(agenda.Upcoming.ToPay)" Label="A pagar" Value="@Negative(agenda.Upcoming.ToPay).ToString()" Testid="to-pay" />
        </div>
        <PendingList Items="agenda.Upcoming.Items" Empty="@($"Nenhuma pendência nos próximos {agenda.WindowDays} dias.")" Label="@($"Pendências dos próximos {agenda.WindowDays} dias")" />
    </section>
    <section class="panel" aria-labelledby="overdue-title">
        <h2 id="overdue-title">Atrasados <HelpTip Text="Data prevista anterior a hoje; não entram nos totais acima." /></h2>
        <div class="stat-cards">
            <StatCard ValueClass="@ValueColor.Income(agenda.Overdue.ToReceive)" Label="Atrasado a receber" Value="@agenda.Overdue.ToReceive.ToString()" Testid="overdue-receive" />
            <StatCard ValueClass="@ValueColor.Expense(agenda.Overdue.ToPay)" Label="Atrasado a pagar" Value="@Negative(agenda.Overdue.ToPay).ToString()" Testid="overdue-pay" />
        </div>
        <PendingList Items="agenda.Overdue.Items" Empty="Nenhuma pendência atrasada." Label="Pendências atrasadas" />
        <p><a href="/pendentes">Ver todas as pendências</a></p>
    </section>
    </div>
}

@code {
    private PendingAgenda? _agenda;

    protected override async Task OnInitializedAsync() => _agenda = await Agenda.GetAsync();

    private static Ags.Finance.SharedKernel.Money Negative(Ags.Finance.SharedKernel.Money value) => value.IsZero ? value : -value;
}
