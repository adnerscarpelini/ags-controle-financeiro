@using Ags.Finance.Modules.Reports.Contracts
@using Ags.Finance.SharedKernel
@inject ICategoryReports Reports

@if (_report is { } report)
{
    <CategoryTable Id="expense-categories" Title="Despesas por categoria" NameHeader="Categoria" Lines="report.Expenses" Total="report.TotalExpenses" Expense="true" Chart="true" TopCount="TopCount" />
    <CategoryTable Id="income-origins" Title="Receitas por origem" NameHeader="Categoria > subcategoria" Lines="report.Income" Total="report.TotalIncome" />
}

@code {
    private CategoryReport? _report;
    private ReferenceMonth _loaded;

    [Parameter, EditorRequired] public ReferenceMonth Month { get; set; }

    /// <summary>Quantas categorias entram no gráfico; a tabela continua completa.</summary>
    [Parameter] public int TopCount { get; set; } = 10;

    protected override async Task OnParametersSetAsync()
    {
        if (_report is not null && _loaded == Month) { return; }
        _loaded = Month;
        _report = await Reports.GetAsync(Month);
    }
}
