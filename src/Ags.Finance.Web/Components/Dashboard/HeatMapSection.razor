@using System.Globalization
@using Ags.Finance.Modules.Reports.Contracts
@using Ags.Finance.SharedKernel
@inject IHeatMapReports Reports

@if (_map is { } map)
{
    <section class="panel" aria-labelledby="heat-map-title">
        <div class="heat-head"><h2 id="heat-map-title">Mapa de calor de @map.Year</h2><span class="heat-unit">Valores em R$</span></div>
        <div class="table-scroll">
            <table class="heat-map" data-money-cells>
                <caption class="visually-hidden">Receitas, despesas e saldo por mês e despesas por categoria e subcategoria</caption>
                <thead><tr><th scope="col">Linha</th>@for (var i = 0; i < 12; i++) { <th scope="col" class="numeric @Selected(map, i)">@MonthName(i)</th> }<th scope="col" class="numeric">Total</th></tr></thead>
                <tbody>
                    <tr><th scope="row">Receitas</th>@for (var i = 0; i < 12; i++) { <td class="numeric @ValueColor.Income(map.Income[i]) @Selected(map, i)">@Cell(map.Income[i])</td> }<td class="numeric @ValueColor.Income(Sum(map.Income))">@Cell(Sum(map.Income))</td></tr>
                    <tr><th scope="row">Despesas</th>@for (var i = 0; i < 12; i++) { <td class="numeric @ValueColor.Expense(map.Expenses[i]) @Selected(map, i)">@Cell(Negative(map.Expenses[i]))</td> }<td class="numeric @ValueColor.Expense(Sum(map.Expenses))">@Cell(Negative(Sum(map.Expenses)))</td></tr>
                    <tr><th scope="row">Saldo</th>@for (var i = 0; i < 12; i++) { <td class="numeric @ValueColor.Balance(map.Balance[i]) @Selected(map, i)">@Cell(map.Balance[i])</td> }<td class="numeric @ValueColor.Balance(Sum(map.Balance))">@Cell(Sum(map.Balance))</td></tr>
                    <tr class="heat-separator"><th scope="colgroup" colspan="14">Despesas por categoria</th></tr>
                    @foreach (var row in map.Rows)
                    {
                        <tr><th scope="row" class="@(row.Level == 1 ? "heat-sub" : string.Empty)">@row.Name</th>
                            @for (var i = 0; i < 12; i++)
                            {
                                var cell = row.Cells[i];
                                <td class="numeric @ValueColor.Expense(cell.Amount) @Selected(map, i)" style="@Style(cell)">@Cell(cell.Amount)</td>
                            }
                            <td class="numeric @ValueColor.Expense(row.Total)">@Cell(row.Total)</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @if (map.Rows.Count == 0) { <p>Nenhuma despesa em @map.Year.</p> }
    </section>
}

@code {
    private HeatMap? _map;
    private ReferenceMonth _loaded;

    [Parameter, EditorRequired] public ReferenceMonth Month { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_map is not null && _loaded == Month) { return; }
        _loaded = Month;
        _map = await Reports.GetAsync(Month);
    }

    private static string MonthName(int index) => CultureInfo.GetCultureInfo("pt-BR").DateTimeFormat.GetAbbreviatedMonthName(index + 1);

    private static string Selected(HeatMap map, int index) => map.SelectedMonth.Month == index + 1 ? "heat-selected" : string.Empty;

    private static Money Sum(IEnumerable<Money> values) => new(values.Sum(x => x.Amount));

    // A unidade aparece uma vez, no título; mês sem valor mostra só o traço.
    private static string Cell(Money value) => value.IsZero ? "-" : value.ToString().Replace("R$ ", string.Empty, StringComparison.Ordinal);

    private static Money Negative(Money expenses) => expenses.IsZero ? expenses : -expenses;

    // Fundo leve para o texto vermelho manter o contraste. A cor nunca é o único sinal: o valor sempre aparece em texto.
    private static string Style(HeatCell cell)
        => cell.Intensity <= 0 ? string.Empty : $"background: color-mix(in srgb, var(--color-expense) {(cell.Intensity * 8).ToString("0", CultureInfo.InvariantCulture)}%, transparent)";
}
