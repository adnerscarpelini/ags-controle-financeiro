@using System.Globalization
@using Ags.Finance.Modules.Reports.Contracts
@using Ags.Finance.SharedKernel
@inject IMonthlySummaries Summaries

<section class="panel" aria-labelledby="summary-title">
    <h2 id="summary-title">Resumo de @Month</h2>
    @if (_summary is { } summary)
    {
        <dl class="metric-grid">
            <div class="metric"><dt>Receitas do mês</dt><dd class="numeric entry-income">@summary.Income</dd></div>
            <div class="metric"><dt>Despesas do mês</dt><dd class="numeric entry-expense">@Negative(summary.Expenses)</dd></div>
            <div class="metric"><dt>Saldo do orçamento mensal</dt><dd class="numeric @(summary.Balance.IsNegative ? "entry-expense" : "entry-income")">@summary.Balance</dd>
                <small>Receitas menos despesas lançadas no mês de referência. Não é o saldo efetivo das contas.</small></div>
            <div class="metric"><dt>% guardado</dt><dd class="numeric">@(summary.SavedPercent is { } percent ? percent.ToString("0.##", CultureInfo.GetCultureInfo("pt-BR")) + "%" : "-")</dd>
                <small>Saldo ÷ receitas</small></div>
            <div class="metric"><dt>Despesas do mês anterior</dt><dd class="numeric entry-expense">@Negative(summary.PreviousMonthExpenses)</dd></div>
            <div class="metric"><dt>Média mensal de despesas no ano</dt><dd class="numeric entry-expense">@Negative(summary.YearAverageExpenses)</dd>
                <small>@summary.MonthsWithExpenses @(summary.MonthsWithExpenses == 1 ? "mês" : "meses") com lançamentos até @Month</small></div>
        </dl>
    }
</section>

@code {
    private MonthlySummary? _summary;
    private ReferenceMonth _loaded;

    [Parameter, EditorRequired] public ReferenceMonth Month { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_summary is not null && _loaded == Month) { return; }
        _loaded = Month;
        _summary = await Summaries.GetAsync(Month);
    }

    private static Money Negative(Money expenses) => expenses.IsZero ? expenses : -expenses;
}
