@* Saldo atual de cada conta corrente, com o total em destaque (issue 143). Poupança e investimento não aparecem nem entram no total. *@
@using Ags.Finance.Modules.Accounts.Contracts
@using Ags.Finance.Modules.Transactions.Contracts
@using Ags.Finance.SharedKernel
@inject IAccountCatalog Accounts
@inject IEntryCatalog Entries
@inject TimeProvider Clock

<section class="panel panel-highlight summary-panel" aria-labelledby="checking-accounts-title">
    <h2 id="checking-accounts-title"><span class="heading-icon heading-icon-accent" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.AccountBalance" /></span>Saldo nas contas correntes <HelpTip Text="Saldo atual das contas correntes ativas. Poupança e investimentos ficam de fora." /></h2>
    @if (_rows is { } rows)
    {
        <strong class="numeric summary-hero @ValueColor.Balance(Sum(rows))" data-current-total>@Sum(rows)</strong>
        @if (rows.Count == 0)
        {
            <p>Nenhuma conta corrente cadastrada.</p>
        }
        else
        {
            <ul class="summary-list" aria-label="Saldo de cada conta corrente">
                @foreach (var row in rows)
                {
                    <li class="summary-item" data-checking-account="@row.Account.Name">
                        <div class="summary-head">
                            @if (row.Bank is not null) { <BankLogo Bank="row.Bank" /> }
                            <div class="summary-title"><span class="summary-name">@row.Account.Name</span></div>
                            <span class="numeric summary-value @ValueColor.Balance(row.Current)" data-current-balance>@row.Current</span>
                        </div>
                    </li>
                }
            </ul>
        }
        <a class="summary-link" href="contas">Ver todas as contas</a>
    }
</section>

@code {
    private sealed record Row(AccountDetails Account, BankDetails? Bank, Money Current);

    private IReadOnlyList<Row>? _rows;

    protected override async Task OnInitializedAsync()
    {
        var today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        var banks = await Accounts.GetBanksAsync();
        var accounts = await Accounts.GetAccountsAsync(activeOnly: true);
        var rows = new List<Row>();
        foreach (var account in accounts.Where(x => x.Kind == AccountKind.Checking))
        {
            // O mesmo saldo atual da tela de contas; a parte prevista não aparece no Dashboard.
            var balance = await Entries.GetBalanceForecastAsync(account.ExternalId, today, ReferenceMonth.FromDate(today));
            rows.Add(new Row(account, banks.FirstOrDefault(x => x.ExternalId == account.BankExternalId), balance?.CurrentBalance ?? Money.Zero));
        }

        _rows = rows;
    }

    private static Money Sum(IEnumerable<Row> rows) => new(rows.Sum(x => x.Current.Amount));
}
