@using System.Globalization
@using Ags.Finance.Modules.Accounts.Contracts
@inject IBankLogoCatalog Logos
@implements IDisposable

<section class="panel crop-root" role="dialog" aria-label="Editar logo do banco" data-crop-root>
    <h2 class="visually-hidden">Logo de @Bank.Name</h2>
    <p class="form-note">PNG, JPEG ou WebP de até 5 MB e 4096 × 4096 pixels. Arraste a imagem para posicionar e use o zoom para ajustar.</p>
    @if (_error is not null) { <p class="form-warning" role="status">@_error</p> }
    <div class="field"><label for="bank-logo-file">Escolher imagem</label><InputFile id="bank-logo-file" OnChange="LoadAsync" accept="image/png,image/jpeg,image/webp" disabled="@(_loading || _saving)" /></div>
    @if (_loading) { <p class="form-note" aria-live="polite">Lendo imagem…</p> }
    @* A área continua montada: a imagem vem direto do arquivo escolhido, sem passar pelo servidor (js/logo-crop.js). *@
    <div class="crop-area" data-crop-area hidden="@(_source is null)">
        <div class="crop-stage" data-crop-stage role="img" aria-label="Área de recorte. Arraste para posicionar a imagem dentro do círculo."><img alt="" draggable="false" /></div>
        <div class="chips" role="group" aria-label="Modo do recorte">
            <button type="button" class="chip @(_zoom >= 1 ? "on" : null)" aria-pressed="@(_zoom >= 1 ? "true" : "false")" title="A imagem cobre todo o círculo" data-crop-mode="fill" disabled="@_saving">Preencher</button>
            <button type="button" class="chip @(_zoom < 1 ? "on" : null)" aria-pressed="@(_zoom < 1 ? "true" : "false")" title="A imagem inteira fica dentro do círculo" data-crop-mode="fit" disabled="@_saving">Ajustar</button>
        </div>
        <div class="field crop-zoom"><label class="visually-hidden" for="logo-zoom">Zoom</label><input id="logo-zoom" class="crop-control" type="range" min="0.2" max="5" step="0.01" @bind="_zoom" @bind:culture="CultureInfo.InvariantCulture" @bind:after="UpdatePreview" disabled="@_saving" /><span class="crop-percent" data-crop-percent>@($"{Math.Round(_zoom * 100)}%")</span></div>
        <div class="visually-hidden">
            <label for="logo-horizontal">Posição horizontal</label><input id="logo-horizontal" class="crop-control" type="range" min="-1" max="1" step="0.001" @bind="_horizontal" @bind:culture="CultureInfo.InvariantCulture" @bind:after="UpdatePreview" disabled="@_saving" />
            <label for="logo-vertical">Posição vertical</label><input id="logo-vertical" class="crop-control" type="range" min="-1" max="1" step="0.001" @bind="_vertical" @bind:culture="CultureInfo.InvariantCulture" @bind:after="UpdatePreview" disabled="@_saving" />
        </div>
    </div>
    <div class="crop-compare">
        <span>Logo atual <BankLogo Bank="Bank" /></span>
        @if (_preview is { } preview)
        {
            <span>Novo logo <img class="bank-logo-preview" src="@($"data:image/png;base64,{Convert.ToBase64String(preview)}")" alt="Prévia do recorte circular" width="30" height="30" /></span>
        }
    </div>
    @if (_confirmRemoval)
    {
        <section class="crop-confirm" role="alertdialog" aria-label="Remover logo"><p>Remover apenas o logo de @Bank.Name? Cadastros e valores serão preservados.</p>
            <div class="form-actions"><button class="button" @onclick="RemoveAsync" disabled="@_saving">Confirmar remoção</button><button class="button button-secondary" @onclick="() => _confirmRemoval = false" disabled="@_saving">Manter logo</button></div></section>
    }
    <div class="form-actions">
        @if (Bank.LogoVersion is not null) { <button class="button button-secondary" @onclick="() => _confirmRemoval = true" disabled="@_saving">Remover logo</button> }
        <button class="button button-secondary" @onclick="() => Cancelled.InvokeAsync()" disabled="@_saving">Cancelar</button>
        <button class="button" @onclick="SaveAsync" disabled="@(_saving || _loading || _preview is null)">Salvar recorte</button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public BankDetails Bank { get; set; } = default!;
    [Parameter] public EventCallback Saved { get; set; }
    [Parameter] public EventCallback Cancelled { get; set; }
    private readonly CancellationTokenSource _cancellation = new();
    private byte[]? _source;
    private byte[]? _preview;
    private double _zoom = 1;
    private double _horizontal;
    private double _vertical;
    private bool _loading;
    private bool _saving;
    private bool _confirmRemoval;
    private string? _error;
    private LogoCrop Crop => new(_zoom, _horizontal, _vertical);
    private async Task LoadAsync(InputFileChangeEventArgs args)
    {
        if (_loading || _saving) { return; }
        _loading = true; _source = null; _preview = null; _error = null;
        try
        {
            if (args.File.Size > IBankLogoCatalog.MaxSourceBytes) { _error = "O arquivo excede 5 MB."; return; }
            using var buffer = new MemoryStream();
            await using var stream = args.File.OpenReadStream(IBankLogoCatalog.MaxSourceBytes, _cancellation.Token);
            await stream.CopyToAsync(buffer, _cancellation.Token);
            _source = buffer.ToArray(); _zoom = 1; _horizontal = 0; _vertical = 0;
            UpdatePreview();
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested) { }
        catch (Exception exception) when (exception is IOException or InvalidOperationException) { _error = "Não foi possível ler o arquivo selecionado."; }
        finally { _loading = false; }
    }
    private void UpdatePreview()
    {
        if (_source is null) { return; }
        var result = Logos.CreatePreview(_source, Crop); _preview = result.Png; _error = result.Error;
    }
    private async Task SaveAsync()
    {
        if (_saving || _loading || _source is null || _preview is null) { return; }
        _saving = true;
        try { var result = await Logos.SaveAsync(Bank.ExternalId, _source, Crop, _cancellation.Token); _error = result.Error; if (result.Succeeded) { await Saved.InvokeAsync(); } }
        finally { _saving = false; }
    }
    private async Task RemoveAsync()
    {
        if (_saving) { return; }
        _saving = true;
        try { var result = await Logos.RemoveAsync(Bank.ExternalId, _cancellation.Token); _error = result.Error; if (result.Succeeded) { await Saved.InvokeAsync(); } }
        finally { _saving = false; }
    }
    public void Dispose() { _cancellation.Cancel(); _cancellation.Dispose(); }
}
