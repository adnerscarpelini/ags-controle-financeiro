@page "/configuracoes"
@using Ags.Finance.Web.Authentication
@using Ags.Finance.Web.Hosting
@inject ServerCertificate ServerCertificate

<PageHeader Title="Configurações" />

<section class="panel" aria-labelledby="password-title">
    <h2 id="password-title">Trocar senha</h2>

    @if (_passwordMessage is not null)
    {
        <p class="@(PasswordOutcome == "changed" ? "form-success" : "form-error")" role="status" data-testid="password-message">@_passwordMessage</p>
    }

    <form method="post" action="@AccountEndpoints.PasswordPath">
        <AntiforgeryToken />

        <div class="field">
            <label for="current-password">Senha atual</label>
            <input id="current-password" name="CurrentPassword" type="password" autocomplete="current-password" required />
        </div>

        <div class="field">
            <label for="new-password">Nova senha (mínimo de 8 caracteres)</label>
            <input id="new-password" name="NewPassword" type="password" autocomplete="new-password" minlength="8" required />
        </div>

        <div class="field">
            <label for="confirm-password">Confirme a nova senha</label>
            <input id="confirm-password" name="ConfirmPassword" type="password" autocomplete="new-password" minlength="8" required />
        </div>

        <button type="submit" class="button">Trocar senha</button>
    </form>
</section>

<section class="panel" aria-labelledby="certificate-title">
    <h2 id="certificate-title">Certificado HTTPS</h2>

    @if (_info is null)
    {
        <p class="expense">Não foi possível carregar o certificado: @_error</p>
    }
    else
    {
        <p>
            @(_info.IsSelfSigned
                ? "Certificado autoassinado gerado por esta instalação."
                : "Certificado próprio configurado em appsettings.json.")
            Válido até @_info.ExpiresAt.ToString("dd/MM/yyyy").
        </p>

        <dl class="facts">
            <dt>Impressão digital (SHA-256)</dt>
            <dd class="fingerprint" data-testid="fingerprint">@_info.Fingerprint</dd>

            <dt>Nomes e endereços</dt>
            <dd>@string.Join(", ", _info.Names)</dd>

            @if (_info.PublicCertificatePath is not null)
            {
                <dt>Arquivo para instalar nos dispositivos</dt>
                <dd class="fingerprint">@_info.PublicCertificatePath</dd>
            }
        </dl>

        <p>
            Para o navegador deixar de avisar sobre o certificado, instale o arquivo acima como confiável em cada
            dispositivo. Ao instalar, confira se a impressão digital é a mesma mostrada aqui. Se o IP do computador
            mudar, o certificado é gerado de novo na próxima recriação do container e precisa ser instalado outra vez.
        </p>

        <details>
            <summary>Windows</summary>
            <ol>
                <li>Copie o arquivo <strong>ags-finance.crt</strong> para o computador.</li>
                <li>Dê dois cliques, escolha <strong>Instalar Certificado</strong> e <strong>Computador Local</strong>.</li>
                <li>Selecione <strong>Colocar todos os certificados no repositório a seguir</strong> e escolha <strong>Autoridades de Certificação Raiz Confiáveis</strong>.</li>
                <li>Conclua e reinicie o navegador.</li>
            </ol>
        </details>

        <details>
            <summary>Linux</summary>
            <ol>
                <li>Copie <strong>ags-finance.crt</strong> para <code>/usr/local/share/ca-certificates/</code> (Debian e Ubuntu) e execute <code>sudo update-ca-certificates</code>.</li>
                <li>No Fedora, use <code>/etc/pki/ca-trust/source/anchors/</code> e <code>sudo update-ca-trust</code>.</li>
                <li>O Firefox usa repositório próprio: em Configurações, Privacidade e segurança, Certificados, Importar.</li>
            </ol>
        </details>

        <details>
            <summary>Android</summary>
            <ol>
                <li>Envie <strong>ags-finance.crt</strong> para o celular.</li>
                <li>Abra Configurações, Segurança e privacidade, Mais configurações de segurança, Criptografia e credenciais, <strong>Instalar um certificado</strong>, <strong>Certificado de CA</strong>. Os nomes variam conforme o fabricante.</li>
                <li>Escolha o arquivo e confirme o aviso. Reinicie o navegador.</li>
            </ol>
        </details>

        <details>
            <summary>iPhone</summary>
            <ol>
                <li>Envie <strong>ags-finance.crt</strong> para o iPhone (AirDrop ou Arquivos) e abra-o.</li>
                <li>Em Ajustes, toque em <strong>Perfil Baixado</strong> e em <strong>Instalar</strong>.</li>
                <li>Em Ajustes, Geral, Sobre, <strong>Ajustes de Confiança de Certificado</strong>, ative a confiança total para o certificado.</li>
            </ol>
        </details>
    }
</section>

@code {
    private ServerCertificateInfo? _info;
    private string? _error;
    private string? _passwordMessage;

    [SupplyParameterFromQuery(Name = "password")]
    private string? PasswordOutcome { get; set; }

    protected override void OnInitialized()
    {
        _passwordMessage = PasswordOutcome switch
        {
            "changed" => "Senha alterada. As outras sessões abertas foram encerradas.",
            "wrong" => "A senha atual está incorreta.",
            "short" => "A nova senha precisa ter no mínimo 8 caracteres.",
            "mismatch" => "A confirmação é diferente da nova senha.",
            "locked" => "Muitas tentativas incorretas. Aguarde alguns minutos e tente de novo.",
            _ => null,
        };

        try
        {
            _info = ServerCertificate.Info;
        }
        catch (Exception exception) when (exception is IOException or System.Security.Cryptography.CryptographicException)
        {
            _error = exception.Message;
        }
    }
}
