@page "/cadastros/categorias"
@using Ags.Finance.Modules.Imports.Contracts
@using Ags.Finance.Modules.Transactions.Contracts
@using Ags.Finance.Web.Components.Layout
@using Ags.Finance.Web.Components.Registries
@inject IClassificationCatalog Catalog
@inject IDialogService Dialogs
@inject ViewportState Viewport
@inject ISnackbar Snackbar

<RegistryPage TItem="CategoryDetails" Title="Categorias" Help="Categorias agrupam subcategorias e são usadas nos relatórios e no planejamento." NewLabel="Nova categoria" OnNew="() => OpenCategoryAsync(null)"
              @bind-Search="_search" Items="Visible" Loaded="_loaded" Message="@_message" OnExternalChange="ReloadAsync" EmptyIcon="@Icons.Material.Outlined.Folder" EmptyMessage="Nenhuma categoria aqui. Cadastre a primeira para classificar os lançamentos.">
    <Toolbar>
        <div class="chips registry-tabs" role="group" aria-label="Tipo de categoria">
            @foreach (var kind in Kinds)
            {
                <button type="button" class="chip @(_kind == kind ? "on" : null)" aria-pressed="@(_kind == kind ? "true" : "false")" data-kind-tab="@kind" @onclick="() => _kind = kind">@KindTabLabel(kind)</button>
            }
        </div>
    </Toolbar>
    <MoreActions><RegistryCsvMenu Kinds="s_kinds" /></MoreActions>
    <Columns>
        <MudTh><MudTableSortLabel T="CategoryDetails" SortBy="x => x.Name" InitialDirection="SortDirection.Ascending">Nome</MudTableSortLabel></MudTh>
        <MudTh>Subcategorias</MudTh>
        <MudTh>Situação</MudTh>
        <MudTh>Ações</MudTh>
    </Columns>
    <Row Context="category">
        <MudTd DataLabel="Nome">
            <span class="category-name">
                <MudTooltip Text="@(IsExpanded(category) ? "Ocultar subcategorias" : "Mostrar subcategorias")">
                    <MudIconButton Icon="@(IsExpanded(category) ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ExpandMore)" Size="Size.Small" aria-label="@($"{(IsExpanded(category) ? "Ocultar" : "Mostrar")} subcategorias de {category.Name}")" aria-expanded="@(IsExpanded(category) ? "true" : "false")" data-expand OnClick="() => Toggle(category)" />
                </MudTooltip>
                <span class="kind-mark kind-@category.Kind.ToString().ToLowerInvariant()" aria-hidden="true"></span>
                <span class="row-title">@category.Name</span>
            </span>
        </MudTd>
        <MudTd DataLabel="Subcategorias">@SubcategoryCount(category)</MudTd>
        <MudTd DataLabel="Situação">@(category.IsActive ? "Ativa" : "Desativada")</MudTd>
        <MudTd DataLabel="Ações" Class="col-actions"><RowActions Actions="ActionsFor(category)" /></MudTd>
    </Row>
    <ChildRow Context="category">
        @if (IsExpanded(category))
        {
            @foreach (var subcategory in SubcategoriesOf(category))
            {
                <tr class="subcategory-row" data-subcategory="@subcategory.Name">
                    <td class="subcategory-name" colspan="2">@subcategory.Name</td>
                    <td>@(subcategory.IsActive ? "Ativa" : "Desativada")</td>
                    <td class="col-actions"><RowActions Actions="ActionsFor(subcategory)" /></td>
                </tr>
            }
            @if (!SubcategoriesOf(category).Any())
            {
                <tr class="subcategory-row"><td class="subcategory-name" colspan="4">Nenhuma subcategoria.</td></tr>
            }
        }
    </ChildRow>
</RegistryPage>

@code {
    private static readonly RegistryKind[] s_kinds = [RegistryKind.Categories, RegistryKind.Subcategories];
    private readonly HashSet<Guid> _expanded = [];
    private IReadOnlyList<CategoryDetails> _categories = [];
    private IReadOnlyList<SubcategoryDetails> _subcategories = [];
    private CategoryKind _kind = CategoryKind.Expense;
    private string _search = string.Empty;
    private string? _message;
    private bool _loaded;

    // Transferências só aparecem quando existem: a alternância aprovada é entre despesas e receitas.
    private IEnumerable<CategoryKind> Kinds => _categories.Any(x => x.Kind == CategoryKind.Transfer)
        ? [CategoryKind.Expense, CategoryKind.Income, CategoryKind.Transfer]
        : [CategoryKind.Expense, CategoryKind.Income];

    private IReadOnlyList<CategoryDetails> Visible => _categories
        .Where(x => x.Kind == _kind && (x.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase) || SubcategoriesOf(x).Any(s => s.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase))))
        .ToList();

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _categories = await Catalog.GetCategoriesAsync(false);
        _subcategories = await Catalog.GetSubcategoriesAsync(false);
        _loaded = true;
    }

    private async Task ReloadAndRenderAsync()
    {
        await ReloadAsync();
        StateHasChanged();
    }

    private IEnumerable<SubcategoryDetails> SubcategoriesOf(CategoryDetails category) => _subcategories.Where(x => x.CategoryExternalId == category.ExternalId);

    private string SubcategoryCount(CategoryDetails category)
    {
        var count = SubcategoriesOf(category).Count();
        return count == 1 ? "1 subcategoria" : $"{count} subcategorias";
    }

    private bool IsExpanded(CategoryDetails category) => _expanded.Contains(category.ExternalId);

    private void Toggle(CategoryDetails category)
    {
        if (!_expanded.Add(category.ExternalId)) { _expanded.Remove(category.ExternalId); }
    }

    private IReadOnlyList<RowAction> ActionsFor(CategoryDetails category)
    {
        var actions = new List<RowAction>
        {
            new("Nova subcategoria", Icons.Material.Outlined.Add, "new-subcategory", EventCallback.Factory.Create(this, () => OpenSubcategoryAsync(null, category.ExternalId))),
            new("Editar", Icons.Material.Outlined.Edit, "edit", EventCallback.Factory.Create(this, () => OpenCategoryAsync(category))),
        };
        if (category.IsActive) { actions.Add(new("Excluir ou desativar", Icons.Material.Outlined.Delete, "delete", EventCallback.Factory.Create(this, () => AskDeactivationAsync(category.ExternalId, false, category.Name)))); }
        return actions;
    }

    private IReadOnlyList<RowAction> ActionsFor(SubcategoryDetails subcategory)
    {
        var actions = new List<RowAction> { new("Editar", Icons.Material.Outlined.Edit, "edit", EventCallback.Factory.Create(this, () => OpenSubcategoryAsync(subcategory, subcategory.CategoryExternalId))) };
        if (subcategory.IsActive) { actions.Add(new("Excluir ou desativar", Icons.Material.Outlined.Delete, "delete", EventCallback.Factory.Create(this, () => AskDeactivationAsync(subcategory.ExternalId, true, subcategory.Name)))); }
        return actions;
    }

    private async Task OpenCategoryAsync(CategoryDetails? category)
    {
        var parameters = new DialogParameters<CategoryDialog>
        {
            { x => x.Category, category },
            { x => x.InitialKind, _kind },
            { x => x.Saved, EventCallback.Factory.Create(this, ReloadAndRenderAsync) },
        };
        await Dialogs.ShowAsync<CategoryDialog>(category is null ? "Nova categoria" : "Editar categoria", parameters, AppDialogs.Options(Viewport, MaxWidth.ExtraSmall));
    }

    private async Task OpenSubcategoryAsync(SubcategoryDetails? subcategory, Guid categoryExternalId)
    {
        _expanded.Add(categoryExternalId);
        var parameters = new DialogParameters<SubcategoryDialog>
        {
            { x => x.Subcategory, subcategory },
            { x => x.CategoryExternalId, categoryExternalId },
            { x => x.Saved, EventCallback.Factory.Create(this, ReloadAndRenderAsync) },
        };
        await Dialogs.ShowAsync<SubcategoryDialog>(subcategory is null ? "Nova subcategoria" : "Editar subcategoria", parameters, AppDialogs.Options(Viewport, MaxWidth.ExtraSmall));
    }

    private async Task AskDeactivationAsync(Guid externalId, bool isSubcategory, string name)
    {
        if (!await ConfirmDialog.AskAsync(Dialogs, "Excluir ou desativar", $"{name}: desativar preserva o histórico e retira o cadastro das novas seleções.", "Desativar", destructive: true)) { return; }
        var result = await Catalog.DeactivateAsync(externalId, isSubcategory);
        _message = result.Error;
        if (result.Succeeded) { Snackbar.Add("Cadastro desativado.", Severity.Success); }
        await ReloadAsync();
    }

    private static string KindTabLabel(CategoryKind kind) => kind switch { CategoryKind.Income => "Receitas", CategoryKind.Transfer => "Transferências", _ => "Despesas" };
}
