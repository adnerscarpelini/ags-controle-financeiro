@page "/anexos"
@using Ags.Finance.Modules.Attachments.Contracts
@using Ags.Finance.Modules.Transactions.Contracts
@using Ags.Finance.Modules.Invoices.Contracts
@using Ags.Finance.Web.Attachments
@inject IAttachmentCatalog Catalog
@inject IEntryAttachmentCatalog Entries
@inject IInvoiceAttachmentCatalog Invoices
@inject AttachmentInventory Inventory
@inject ILogger<Attachments> Logger
@inject TimeProvider Clock
@inject ISnackbar Snackbar

<div class="page-head">
    <PageHeader Title="Anexos" />
    <HelpTip Text="@($"Uso de disco: {_diskBytes / 1048576m:N2} MB, em {_all.Count} registro(s). A lixeira permite baixar e restaurar por 30 dias. Donos excluídos impedem a restauração.")" />
    <div class="page-head-actions">
        <div class="chips" role="group" aria-label="Situação dos anexos">
            <button type="button" class="chip @(_trash ? null : "on")" aria-pressed="@(_trash ? "false" : "true")" data-attachments-tab="active" @onclick="() => _trash = false">Ativos</button>
            <button type="button" class="chip @(_trash ? "on" : null)" aria-pressed="@(_trash ? "true" : "false")" data-attachments-tab="trash" @onclick="() => _trash = true">Lixeira</button>
        </div>
        <input id="attachments-search" class="input registry-search" type="search" placeholder="Buscar por nome" aria-label="Buscar por nome" @bind="_search" @bind:event="oninput" />
        <MudTooltip Text="Filtrar por tipo e data de envio">
            <MudIconButton Icon="@Icons.Material.Outlined.FilterList" Variant="Variant.Outlined" aria-label="Filtros" aria-expanded="@(_filtersOpen ? "true" : "false")" data-toggle-filters OnClick="() => _filtersOpen = !_filtersOpen" />
        </MudTooltip>
        <MudTooltip Text="Baixar um ZIP com os documentos do período">
            <MudIconButton Icon="@Icons.Material.Outlined.FolderZip" Variant="Variant.Outlined" aria-label="Exportar ZIP" aria-expanded="@(_exportOpen ? "true" : "false")" data-toggle-export OnClick="() => _exportOpen = !_exportOpen" />
        </MudTooltip>
    </div>
</div>

@if (_error is not null) { <p class="form-error" role="alert" data-attachments-error>@_error</p> }

@if (_filtersOpen)
{
    <section class="panel filters-panel attachment-controls" aria-label="Filtros">
        <div class="catalog-fields">
            <div class="field"><label for="attachments-kind">Tipo</label><select id="attachments-kind" class="input" @bind="_kind"><option value="">Todos</option>@foreach (var kind in Enum.GetValues<AttachmentKind>()) { <option value="@kind">@AttachmentPicker.Label(kind)</option> }</select></div>
            <div class="field"><label for="attachments-from">Upload de</label><input id="attachments-from" class="input" type="date" @bind="_from" /></div>
            <div class="field"><label for="attachments-to">Upload até</label><input id="attachments-to" class="input" type="date" @bind="_to" /></div>
        </div>
    </section>
}

@if (_exportOpen)
{
    <section class="panel filters-panel attachment-controls" aria-label="Exportar ZIP">
        <p class="form-note">Use a data do lançamento; faturas e pagamentos usam o mês da fatura. Na compra parcelada, vale a primeira parcela ainda existente, na ordem das parcelas. A lixeira fica de fora.</p>
        <p class="form-note">O ZIP contém indice.csv e SHA256SUMS, não é criptografado e não substitui o backup.</p>
        <div class="catalog-fields">
            <div class="field"><label for="attachment-export-from">Período de</label><input id="attachment-export-from" class="input" type="date" @bind="_exportFrom" required /></div>
            <div class="field"><label for="attachment-export-to">Período até</label><input id="attachment-export-to" class="input" type="date" @bind="_exportTo" required /></div>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@ExportUrl" data-export-zip>Exportar documentos do período e tipo selecionados</MudButton>
    </section>
}

<section class="panel data-panel">
    <MudTable T="AttachmentDetails" Items="Visible" Elevation="0" Hover="true" Class="data-table" Breakpoint="AppTables.Breakpoint(IsMobile)" SortLabel="@AppTables.SortLabel" RowsPerPage="50" aria-label="Anexos">
        <HeaderContent>
            <MudTh><MudTableSortLabel T="AttachmentDetails" SortBy="x => x.OriginalFileName">Arquivo</MudTableSortLabel></MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh><MudTableSortLabel T="AttachmentDetails" SortBy="x => x.CreatedAt" InitialDirection="SortDirection.Descending">Enviado em</MudTableSortLabel></MudTh>
            <MudTh Class="numeric">Tamanho</MudTh>
            @if (_trash) { <MudTh>Remoção <HelpTip Text="Quando o anexo sai da lixeira e deixa de poder ser restaurado." /></MudTh> }
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate Context="row">
            <MudTd DataLabel="Arquivo"><span class="row-title">@row.OriginalFileName</span></MudTd>
            <MudTd DataLabel="Tipo">@AttachmentPicker.Label(row.Kind)</MudTd>
            <MudTd DataLabel="Enviado em">@row.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Tamanho" Class="numeric">@((row.SizeBytes + 1023) / 1024) KiB</MudTd>
            @if (_trash)
            {
                <MudTd DataLabel="Remoção" data-trash-removal>@RemovalText(row)</MudTd>
            }
            <MudTd DataLabel="Ações" Class="col-actions">
                <div class="row-actions">
                    <MudTooltip Text="Abrir"><MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Href="@($"/attachments/{row.ExternalId}")" Target="_blank" aria-label="Abrir" /></MudTooltip>
                    <MudTooltip Text="Baixar"><MudIconButton Icon="@Icons.Material.Outlined.Download" Size="Size.Small" Href="@($"/attachments/{row.ExternalId}?download=true")" aria-label="Baixar" /></MudTooltip>
                    @if (row.DeletedAt is null)
                    {
                        <MudTooltip Text="Mover para a lixeira por 30 dias"><MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" aria-label="Mover para a lixeira" data-action="trash" Disabled="@_busy" OnClick="() => ChangeAsync(row, false)" /></MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="Restaurar da lixeira"><MudIconButton Icon="@Icons.Material.Outlined.RestoreFromTrash" Size="Size.Small" aria-label="Restaurar" data-action="restore" Disabled="@(_busy || row.DeletedAt <= Clock.GetUtcNow().AddDays(-30))" OnClick="() => ChangeAsync(row, true)" /></MudTooltip>
                    }
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <EmptyState Icon="@Icons.Material.Outlined.AttachFile" Message="@(_trash ? "A lixeira está vazia." : "Nenhum documento neste filtro. Anexe pela ação Anexar de um lançamento ou fatura.")" />
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="s_pageSizes" RowsPerPageString="Linhas por página:" InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>
</section>

@code {
    [CascadingParameter(Name = "IsMobile")]
    public bool IsMobile { get; set; }

    private static readonly int[] s_pageSizes = [25, 50, 100];
    private IReadOnlyList<AttachmentDetails> _all = [];
    private AttachmentKind? _kind;
    private DateOnly? _from;
    private DateOnly? _to;
    private DateOnly _exportFrom;
    private DateOnly _exportTo;
    private long _diskBytes;
    private string _search = string.Empty;
    private bool _trash;
    private bool _filtersOpen;
    private bool _exportOpen;
    private bool _busy;
    private string? _error;

    private string ExportUrl => FormattableString.Invariant($"/attachments/export?from={_exportFrom:yyyy-MM-dd}&to={_exportTo:yyyy-MM-dd}") + (_kind is { } kind ? $"&kind={kind}" : string.Empty);

    private IReadOnlyList<AttachmentDetails> Visible => _all.Where(x => (x.DeletedAt is not null) == _trash && (_kind is null || x.Kind == _kind)
        && (_from is null || DateOnly.FromDateTime(x.CreatedAt.LocalDateTime) >= _from) && (_to is null || DateOnly.FromDateTime(x.CreatedAt.LocalDateTime) <= _to)
        && x.OriginalFileName.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase)).OrderByDescending(x => x.CreatedAt).ToList();

    private static string RemovalText(AttachmentDetails row) => row.DeletedAt is { } deleted ? deleted.ToLocalTime().AddDays(30).ToString("dd/MM/yyyy") : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _exportTo = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        _exportFrom = new(_exportTo.Year, _exportTo.Month, 1);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _all = await Catalog.ListAsync();
        try { _diskBytes = Inventory.DiskUsageBytes(); }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
        {
            Ags.Finance.Web.Hosting.OperationLog.Failed(Logger, "Consulta do uso da pasta de anexos", exception);
            _error = "Não foi possível consultar o uso da pasta de anexos.";
        }
    }

    private async Task ChangeAsync(AttachmentDetails row, bool restore)
    {
        if (_busy) { return; }
        _busy = true;
        try
        {
            var result = row.Owner.Type is AttachmentOwnerType.Entry or AttachmentOwnerType.Purchase
                ? restore ? await Entries.RestoreAsync(row.Owner.ExternalId, row.ExternalId) : await Entries.TrashAsync(row.Owner.ExternalId, row.ExternalId)
                : restore ? await Invoices.RestoreAsync(row.Owner, row.ExternalId) : await Invoices.TrashAsync(row.Owner, row.ExternalId);
            _error = result.Error;
            if (result.Succeeded) { Snackbar.Add(restore ? "Anexo restaurado." : "Anexo movido para a lixeira.", Severity.Success); }
            await LoadAsync();
        }
        finally { _busy = false; }
    }
}
