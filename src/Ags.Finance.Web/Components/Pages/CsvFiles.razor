@page "/arquivos-csv"
@using Ags.Finance.Modules.Imports.Contracts
@using Ags.Finance.Modules.Transactions.Contracts
@using Ags.Finance.Web.Csv
@inject ISavedFilterCatalog SavedFilters

<div class="page-head">
    <PageHeader Title="Arquivos CSV" />
    <HelpTip Text="Serve para levar cadastros e lançamentos no layout oficial do sistema. Não substitui o backup." />
    <div class="page-head-actions">
        <div class="chips" role="group" aria-label="Operação">
            <button type="button" class="chip @(_export ? null : "on")" aria-pressed="@(_export ? "false" : "true")" data-csv-tab="import" @onclick="() => _export = false">Importar</button>
            <button type="button" class="chip @(_export ? "on" : null)" aria-pressed="@(_export ? "true" : "false")" data-csv-tab="export" @onclick="() => _export = true">Exportar</button>
        </div>
    </div>
</div>

<div hidden="@_export" class="csv-panel" data-csv-panel="import">
    <RegistryImportPanel />
    <TransactionImportPanel />
</div>

<div hidden="@(!_export)" class="csv-panel" data-csv-panel="export">
    <section class="panel">
        <h2>Cadastros</h2>
        <p class="form-note">Layout oficial e versionado do sistema, em UTF-8 com vírgula como separador. A exportação só lê dados: não altera cadastros nem saldos.
            CSV não substitui o backup do banco de dados.</p>
        <MudTable T="Item" Items="s_items" Elevation="0" Class="data-table" Breakpoint="AppTables.Breakpoint(IsMobile)" SortLabel="@AppTables.SortLabel" aria-label="Cadastros para exportar">
            <HeaderContent>
                <MudTh>Cadastro</MudTh>
                <MudTh>Baixar</MudTh>
            </HeaderContent>
            <RowTemplate Context="item">
                <MudTd DataLabel="Cadastro">@item.Label</MudTd>
                <MudTd DataLabel="Baixar" Class="csv-links">
                    <a data-enhance-nav="false" href="/csv/cadastros/@CsvEndpoints.Slug(item.Kind)">Exportar</a>
                    <a data-enhance-nav="false" href="/csv/cadastros/@CsvEndpoints.Slug(item.Kind)/modelo">Modelo vazio</a>
                    <a data-enhance-nav="false" href="/csv/cadastros/@CsvEndpoints.Slug(item.Kind)/exemplo">Exemplo fictício</a>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </section>
    <section class="panel">
        <h2>Lançamentos</h2>
        <p class="form-note">Receitas e despesas (avulsas, de cartão, parceladas e recorrentes), com mês de referência, centavos, vínculos e estado Pendente/Pago ou Recebido. Ajustes de fatura, transferências e
            pagamentos de fatura não fazem parte do layout. Baixe também as séries recorrentes referenciadas pelo mesmo filtro.</p>
        <form id="transaction-export" method="get" action="/csv/lancamentos" data-enhance-nav="false">
            <div class="catalog-fields">
                <div class="field"><label for="export-month">Mês de referência</label><input id="export-month" class="input" name="month" type="month" /></div>
                <div class="field"><label for="export-from">De</label><input id="export-from" class="input" name="from" type="date" /></div>
                <div class="field"><label for="export-to">Até</label><input id="export-to" class="input" name="to" type="date" /></div>
                <div class="field"><label for="export-saved">Filtro salvo</label><select id="export-saved" class="input" name="savedFilter">
                    <option value="">Nenhum</option>@foreach (var filter in _filters) { <option value="@filter.ExternalId">@filter.Name</option> }
                </select></div>
                <div class="field"><label for="export-effective">Situação</label><select id="export-effective" class="input" name="effective"><option value="">Todas</option><option value="true">Pago ou Recebido</option><option value="false">Pendente</option></select></div>
                <div class="field"><label for="export-text">Texto</label><input id="export-text" class="input" name="text" maxlength="200" /></div>
            </div>
            <div class="filters-actions">
                <button class="button">Exportar lançamentos</button>
                <button class="button" type="submit" formaction="/csv/lancamentos/series">Exportar séries recorrentes</button>
            </div>
        </form>
        <p class="csv-links">
            <a data-enhance-nav="false" href="/csv/lancamentos/modelo">Modelo de lançamentos</a>
            <a data-enhance-nav="false" href="/csv/lancamentos/exemplo">Exemplo de lançamentos</a>
            <a data-enhance-nav="false" href="/csv/lancamentos/series/modelo">Modelo de séries</a>
            <a data-enhance-nav="false" href="/csv/lancamentos/series/exemplo">Exemplo de séries</a>
        </p>
    </section>
</div>

@code {
    [CascadingParameter(Name = "IsMobile")]
    public bool IsMobile { get; set; }

    private IReadOnlyList<SavedFilterDetails> _filters = [];
    private bool _export;

    protected override async Task OnInitializedAsync() => _filters = await SavedFilters.GetAsync();

    private sealed record Item(RegistryKind Kind, string Label);

    // Na ordem de importação documentada.
    private static readonly Item[] s_items =
    [
        new(RegistryKind.Banks, "Bancos"),
        new(RegistryKind.Accounts, "Contas"),
        new(RegistryKind.Cards, "Cartões"),
        new(RegistryKind.CardDigits, "Finais de cartão"),
        new(RegistryKind.Categories, "Categorias"),
        new(RegistryKind.Subcategories, "Subcategorias"),
        new(RegistryKind.Merchants, "Descrições"),
        new(RegistryKind.People, "Pessoas"),
    ];
}
