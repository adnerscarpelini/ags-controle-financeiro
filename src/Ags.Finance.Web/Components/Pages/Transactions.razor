@page "/lancamentos"
@using System.Globalization
@using Ags.Finance.Modules.Accounts.Contracts
@using Ags.Finance.Modules.Preferences.Contracts
@using Ags.Finance.Modules.Reimbursements.Contracts
@using Ags.Finance.Modules.Transactions.Contracts
@using Ags.Finance.SharedKernel
@inject IEntryAttachmentCatalog EntryDocuments
@inject IEntryCatalog Entries
@inject ISavedFilterCatalog SavedFilterCatalog
@inject IAccountCatalog Accounts
@inject IMerchantCatalog Merchants
@inject IClassificationCatalog Classifications
@inject IAccountingMonthCalculator Calendar
@inject ICardLastDigitsCatalog CardDigits
@inject TimeProvider Clock
@inject IPreferences Preferences
@inject IPersonCatalog People

<PageHeader Title="Lançamentos" />
@if (_message is not null) { <p role="status">@_message</p> }
@if (_anticipating is { } anticipating) { <InstallmentAnticipationDialog @key="anticipating.ExternalId" Entry="anticipating" Confirmed="AnticipatedAsync" Cancelled="() => _anticipating = null" /> }
@if (_effectiveEntry is { } pending)
{
    <EffectiveEntryDialog @key="pending.ExternalId" Entry="pending" Confirmed="EffectiveConfirmedAsync" Cancelled="() => _effectiveEntry = null" />
}
@if (_deleteEntry is { } deleting)
{
    <section class="panel" role="alertdialog" aria-label="Confirmar exclusão">
        <h2>Excluir lançamento</h2>
        <p>@deleting.MerchantName · @deleting.Date.ToString("dd/MM/yyyy") · @deleting.Amount</p>
        @if (deleting.RecurringEntryExternalId is not null)
        {
            <div class="field"><label for="delete-recurring-scope">Alcance da exclusão</label><select id="delete-recurring-scope" @bind="_deleteRecurringScope">
                <option value="">Escolha o alcance</option><option value="@RecurringChangeScope.OnlyThis">Somente esta</option><option value="@RecurringChangeScope.ThisAndFollowing">Esta e as seguintes</option><option value="@RecurringChangeScope.All">Todas</option>
            </select></div>
        }
        else if (deleting.InstallmentPurchaseExternalId is not null)
        {
            <div class="field"><label for="delete-scope">Alcance da exclusão</label><select id="delete-scope" @bind="_deleteScope">
                <option value="">Escolha o alcance</option><option value="@EntryChangeScope.OnlyThis">Somente esta parcela</option><option value="@EntryChangeScope.ThisAndFollowing">Esta e as futuras</option>
            </select></div>
        }
        <button class="button" @onclick="ConfirmDeleteAsync" disabled="@_busy">Confirmar exclusão</button>
        <button class="button" @onclick="() => _deleteEntry = null" disabled="@_busy">Cancelar</button>
    </section>
}
@if (_attachmentEntry is { } attachmentEntry) { <EntryAttachments @key="attachmentEntry" EntryExternalId="attachmentEntry" Changed="ReloadAttachmentCountsAsync" /> }
<section class="panel">
    <h2>@(_editingId is null ? "Novo lançamento" : "Editar lançamento")</h2>
    <p>Ctrl+N inicia um lançamento. Enter confirma. Informe o valor sem sinal.</p>
    <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="catalog-fields">
            <div class="field"><label for="entry-date">Data</label><input id="entry-date" type="date" @bind="_date" @bind:after="DateChangedAsync" required /></div>
            <div class="field"><label for="entry-merchant">Descrição</label><input id="entry-merchant" value="@_merchantName" @oninput="SearchMerchantAsync" list="entry-merchants" maxlength="100" required />
                <datalist id="entry-merchants">@foreach (var merchant in _suggestions) { <option value="@merchant.Name"></option> }</datalist>
                <button class="button" type="button" @onclick="CreateMerchantAsync" disabled="@_busy">Cadastrar nova descrição</button>
            </div>
            <div class="field"><label for="entry-subcategory">Classificação</label><select id="entry-subcategory" @bind="_subcategoryId" @bind:after="ClassificationChanged" required>
                <option value="@Guid.Empty">Selecione</option>
                @foreach (var item in _subcategories.Where(x => x.Kind != CategoryKind.Transfer)) { <option value="@item.ExternalId">@item.DisplayName</option> }
            </select></div>
            <div class="field"><label for="entry-amount">@(_installments > 1 ? "Valor total (R$)" : "Valor (R$)")</label><input id="entry-amount" type="number" step="0.01" min="0.01" @bind="_amount" required /></div>
            <div class="field"><label for="entry-card">Cartão (opcional)</label><select id="entry-card" @bind="_cardId" @bind:after="CardChangedAsync">
                <option value="@Guid.Empty">Sem cartão</option>
                @foreach (var card in _cards) { <option value="@card.ExternalId">@card.Name</option> }
            </select></div>
            @if (_cardId != Guid.Empty)
            {
                <div class="field"><label for="entry-final">Final (opcional)</label><select id="entry-final" @bind="_finalId">
                    <option value="@Guid.Empty">Sem final</option>
                    @foreach (var final in _finals) { <option value="@final.ExternalId">@final.Digits · @final.Label</option> }
                </select></div>
                @if (_editingId is null && !_repeat) { <div class="field"><label for="entry-installments">Parcelas (1 para compra avulsa)</label><input id="entry-installments" type="number" min="1" max="48" @bind="_installments" required /></div> }
            }
            <div class="field"><label for="entry-account">Conta</label><select id="entry-account" @bind="_accountId" disabled="@(_cardId != Guid.Empty)" required>
                <option value="@Guid.Empty">Selecione</option>
                @foreach (var account in _accounts) { <option value="@account.ExternalId">@account.Name</option> }
            </select></div>
            <div class="field"><label for="entry-month">Mês contábil</label><input id="entry-month" type="month" value="@_month" @onchange="args => _month = args.Value?.ToString() ?? string.Empty" required /></div>
            <div class="field"><label for="entry-details">Detalhes</label><input id="entry-details" @bind="_details" maxlength="1000" /></div>
            @if (CanHaveReimbursement)
            {
                <div class="field"><label for="entry-reimbursement-person">Pessoa do reembolso (opcional)</label><select id="entry-reimbursement-person" @bind="_reimbursementPersonId" @bind:after="ReimbursementPersonChanged">
                    <option value="@Guid.Empty">Sem reembolso</option>
                    @foreach (var person in _people) { <option value="@person.ExternalId">@person.Name</option> }
                </select></div>
                @if (_reimbursementPersonId != Guid.Empty)
                {
                    <div class="field"><label for="entry-reimbursement-percent">Percentual do reembolso (0 a 100)</label><input id="entry-reimbursement-percent" type="number" step="0.01" min="0" max="100" @bind="_reimbursementPercent" required /></div>
                }
            }
            @if (_editingRecurring)
            {
                <div class="field"><label for="entry-recurring-scope">Alcance da alteração</label><select id="entry-recurring-scope" @bind="_recurringScope" required>
                    <option value="">Escolha o alcance</option><option value="@RecurringChangeScope.OnlyThis">Somente esta</option><option value="@RecurringChangeScope.ThisAndFollowing">Esta e as seguintes</option><option value="@RecurringChangeScope.All">Todas</option>
                </select></div>
                @if (_recurringScope is RecurringChangeScope.ThisAndFollowing or RecurringChangeScope.All)
                {
                    <div class="field"><label for="entry-recurring-day">Dia das próximas ocorrências</label><input id="entry-recurring-day" type="number" min="1" max="31" @bind="_recurringDay" required /></div>
                }
            }
            else if (_editingInstallment)
            {
                <div class="field"><label for="entry-scope">Alcance da alteração</label><select id="entry-scope" @bind="_scope" required>
                    <option value="">Escolha o alcance</option><option value="@EntryChangeScope.OnlyThis">Somente esta parcela</option><option value="@EntryChangeScope.ThisAndFollowing">Esta e as futuras</option>
                </select></div>
            }
        </div>
        @if (_editingId is null)
        {
            <label class="checkbox"><input id="entry-repeat" type="checkbox" @bind="_repeat" @bind:after="RepeatChanged" />Repetir todo mês no dia @_date.Day</label>
            @if (_repeat)
            {
                <div class="field"><label for="entry-repeat-until">Até o mês da ocorrência (vazio para sem fim)</label><input id="entry-repeat-until" type="month" value="@_repeatUntil" @onchange="args => _repeatUntil = args.Value?.ToString() ?? string.Empty" /></div>
            }
        }
        <AttachmentPicker @ref="_attachmentPicker" />
        @if (_savedAttachmentEntry is not null) { <button class="button" type="button" @onclick="RetryAttachmentsAsync" disabled="@_busy">Reenviar anexos do lançamento salvo</button> }
        <button class="button" disabled="@(_busy || _savedAttachmentEntry is not null)">Salvar lançamento</button>
        <button class="button" type="button" data-new-entry @onclick="StartNew" disabled="@_busy">Novo / limpar</button>
    </form>
</section>
<section class="panel">
    <h2>Histórico</h2>
    <div class="catalog-fields" aria-label="Filtros salvos">
        <div class="field"><label for="saved-filter">Filtro salvo</label><select id="saved-filter" @bind="_savedFilterId" @bind:after="ApplySavedFilterAsync" disabled="@(_busy || _queryBusy)">
            <option value="@Guid.Empty">Nenhum</option>@foreach (var item in _savedFilters) { <option value="@item.ExternalId">@item.Name</option> }
        </select></div>
        <div class="field"><label for="saved-filter-name">Nome do filtro</label><input id="saved-filter-name" @bind="_savedFilterName" maxlength="100" /></div>
        <div>
            <button class="button" type="button" @onclick="() => SaveCurrentFilterAsync(null)" disabled="@(_busy || _queryBusy)">Salvar filtro atual</button>
            @if (_savedFilterId != Guid.Empty)
            {
                <button class="button" type="button" @onclick="() => SaveCurrentFilterAsync(_savedFilterId)" disabled="@(_busy || _queryBusy || _savedFilterName.Length == 0)">Renomear e atualizar</button>
                <button class="button" type="button" @onclick="DeleteSavedFilterAsync" disabled="@(_busy || _queryBusy)">Excluir filtro</button>
            }
        </div>
    </div>
    <form id="entry-filters" @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
        <div class="catalog-fields">
            <div class="field"><label for="filter-month">Mês contábil</label><input id="filter-month" type="month" value="@_filterMonth" @onchange="args => _filterMonth = args.Value?.ToString() ?? string.Empty" /></div>
            <div class="field"><label for="filter-from">De</label><input id="filter-from" type="date" @bind="_filterFrom" /></div>
            <div class="field"><label for="filter-to">Até</label><input id="filter-to" type="date" @bind="_filterTo" /></div>
            <div class="field"><label for="filter-account">Conta</label><select id="filter-account" @bind="_filterAccount">
                <option value="@Guid.Empty">Todas</option>@foreach (var item in _filterAccounts) { <option value="@item.ExternalId">@item.Name</option> }
            </select></div>
            <div class="field"><label for="filter-card">Cartão</label><select id="filter-card" @bind="_filterCard" @bind:after="FilterCardChangedAsync">
                <option value="@Guid.Empty">Todos</option>@foreach (var item in _filterCards) { <option value="@item.ExternalId">@item.Name</option> }
            </select></div>
            <div class="field"><label for="filter-final">Final</label><select id="filter-final" @bind="_filterFinal">
                <option value="@Guid.Empty">Todos</option>@foreach (var item in _filterFinals) { <option value="@item.ExternalId">@item.Digits · @item.Label</option> }
            </select></div>
            <div class="field"><label for="filter-category">Categoria</label><select id="filter-category" @bind="_filterCategory">
                <option value="@Guid.Empty">Todas</option>@foreach (var item in _filterCategories) { <option value="@item.ExternalId">@item.Name</option> }
            </select></div>
            <div class="field"><label for="filter-subcategory">Subcategoria</label><select id="filter-subcategory" @bind="_filterSubcategory">
                <option value="@Guid.Empty">Todas</option>@foreach (var item in _filterSubcategories) { <option value="@item.ExternalId">@item.DisplayName</option> }
            </select></div>
            <div class="field"><label for="filter-effective">Situação</label><select id="filter-effective" value="@(_filterEffective?.ToString().ToLowerInvariant() ?? string.Empty)" @onchange="args => _filterEffective = bool.TryParse(args.Value?.ToString(), out var effective) ? effective : null">
                <option value="">Todas</option><option value="true">Efetivado</option><option value="false">Pendente</option>
            </select></div>
            <div class="field"><label for="entry-search">Buscar descrição ou detalhes (Ctrl+F)</label><input id="entry-search" data-entry-search @bind="_filterText" maxlength="200" /></div>
        </div>
        <button class="button" disabled="@(_busy || _queryBusy)">Filtrar</button>
        <button class="button" type="button" @onclick="ClearFiltersAsync" disabled="@(_busy || _queryBusy)">Limpar filtros</button>
    </form>
    @if (_queryBusy) { <p aria-live="polite">Consultando lançamentos…</p> }
    <button class="button" data-duplicate-selected disabled="@(_selectedId is null || _busy)" @onclick="DuplicateSelectedAsync">Duplicar selecionado (Ctrl+D)</button>
    <ul class="catalog-list">
        @foreach (var entry in _entries)
        {
            <li><span>@entry.Date.ToString("dd/MM/yyyy") · @entry.MerchantName · @entry.Classification</span>
                <span class="numeric @(entry.Amount.IsNegative ? "entry-expense" : "entry-income")">@(entry.Amount.IsNegative ? string.Empty : "+")@entry.Amount</span>
                <span class="@(entry.Month > _currentMonth ? "entry-month-future" : string.Empty)">Mês @entry.Month @(entry.Month > _currentMonth ? "(mês futuro)" : string.Empty)</span>
                <span>@(entry.CardExternalId is not null ? "Compra no cartão" : entry.IsEffective ? "Efetivado" : "Pendente") · @entry.Details</span>
                @if (entry.InstallmentNumber is not null) { <span>Parcela @entry.InstallmentNumber/@entry.InstallmentCount</span> }
                @if (entry.Reimbursement is { } reimbursement) { <span>Reembolso: @PersonName(reimbursement.PersonExternalId) · @reimbursement.Percent.ToString("0.##", CultureInfo.GetCultureInfo("pt-BR"))%</span> }
                @if (entry.RecurringEntryExternalId is not null) { <span>Recorrente @(entry.Date > DateOnly.FromDateTime(Clock.GetLocalNow().DateTime) ? "· prevista" : string.Empty)</span> }
                <div>
                    @if (entry.IsInvoiceAdjustment)
                    {
                        <span>Ajuste de fatura · corrija por um novo ajuste no detalhe da fatura.</span>
                    }
                    else
                    {
                    <button class="button" @onclick="() => _selectedId = entry.ExternalId">@(_selectedId == entry.ExternalId ? "Selecionado" : "Selecionar")</button>
                        <button class="button" @onclick="() => _attachmentEntry = entry.ExternalId">📎 Anexos (@AttachmentCount(entry))</button>
                        <button class="button" @onclick="() => EditEntryAsync(entry)" disabled="@_busy">Editar</button>
                        <button class="button" @onclick="() => AskDelete(entry)" disabled="@_busy">Excluir</button>
                    @if (entry.InstallmentPurchaseExternalId is not null) { <button class="button" @onclick="() => _anticipating = entry" disabled="@_busy">Antecipar parcelas</button> }
                    @if (!entry.IsEffective && entry.CardExternalId is null && entry.RecurringEntryExternalId is not null)
                    {
                        <button class="button" @onclick="() => _effectiveEntry = entry" disabled="@_busy">Registrar baixa manual</button>
                    }
                    @if (entry.IsEffective && entry.CardExternalId is null) { <span>Baixa em @entry.EffectiveDate?.ToString("dd/MM/yyyy") · Confirmada em @entry.EffectiveAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span> }
                    }
                </div>
            </li>
        }
    </ul>
    @if (_query.TotalCount == 0) { <p>Nenhum lançamento neste filtro.</p> }
    <footer aria-label="Totais do filtro">
        <p>Receitas: <span class="numeric entry-income">@Signed(_query.Income)</span></p>
        <p>Despesas: <span class="numeric entry-expense">@Signed(_query.Expenses)</span></p>
        <p>Saldo: <span class="numeric @(_query.Balance.IsNegative ? "entry-expense" : "entry-income")">@Signed(_query.Balance)</span></p>
        <p>@_query.TotalCount lançamentos · Página @_query.Page de @_query.TotalPages</p>
        <button class="button" disabled="@(_query.Page <= 1 || _queryBusy || _busy)" @onclick="() => ChangePageAsync(_query.Page - 1)">Anterior</button>
        <button class="button" disabled="@(_query.Page >= _query.TotalPages || _queryBusy || _busy)" @onclick="() => ChangePageAsync(_query.Page + 1)">Próxima</button>
    </footer>
</section>

@code {
    private Guid? _attachmentEntry;
    private Guid? _savedAttachmentEntry;
    private AttachmentPicker? _attachmentPicker;
    private IReadOnlyList<Ags.Finance.Modules.Attachments.Contracts.AttachmentDetails> _attachmentRows = [];
    private int AttachmentCount(EntryDetails entry) => _attachmentRows.Count(x => x.DeletedAt is null && x.Owner.ExternalId == (entry.InstallmentPurchaseExternalId ?? entry.ExternalId));
    private async Task ReloadAttachmentCountsAsync() => _attachmentRows = await EntryDocuments.ListAsync();
    private void StartNew() { _savedAttachmentEntry = null; _attachmentPicker?.Clear(); Reset(); }
    private async Task RetryAttachmentsAsync()
    {
        if (_savedAttachmentEntry is { } id && _attachmentPicker is not null)
        {
            var uploaded = await _attachmentPicker.SendAsync((kind, name, content) => EntryDocuments.UploadAsync(id, kind, name, content));
            _message = uploaded ? "Documentos enviados ao lançamento salvo." : "O lançamento está salvo. Tente enviar os documentos novamente, sem salvar outro lançamento.";
            if (uploaded) { _savedAttachmentEntry = null; }
        }
    }
    private IReadOnlyList<AccountDetails> _accounts = [];
    private IReadOnlyList<CreditCardDetails> _cards = [];
    private IReadOnlyList<CardLastDigitsDetails> _finals = [];
    private IReadOnlyList<MerchantDetails> _merchants = [];
    private IReadOnlyList<MerchantDetails> _suggestions = [];
    private IReadOnlyList<SubcategoryDetails> _subcategories = [];
    private IReadOnlyList<EntryDetails> _entries = [];
    private IReadOnlyList<PersonDetails> _people = [];
    private Guid _reimbursementPersonId;
    private decimal _reimbursementPercent;
    private bool IsExpense => _subcategories.FirstOrDefault(x => x.ExternalId == _subcategoryId)?.Kind == CategoryKind.Expense;
    private bool CanHaveReimbursement => IsExpense && !_repeat && !_editingRecurring;
    private string PersonName(Guid externalId) => _people.FirstOrDefault(x => x.ExternalId == externalId)?.Name ?? "Pessoa";
    private void ClearReimbursement() { _reimbursementPersonId = Guid.Empty; _reimbursementPercent = 0; }
    private void ClassificationChanged() { if (!IsExpense) { ClearReimbursement(); } }
    private void ReimbursementPersonChanged() => _reimbursementPercent = PlainPercent(_people.FirstOrDefault(x => x.ExternalId == _reimbursementPersonId)?.DefaultPercent ?? 0);
    private static decimal PlainPercent(decimal value) => decimal.Parse(value.ToString("0.##", CultureInfo.InvariantCulture), CultureInfo.InvariantCulture);
    private DateOnly _date;
    private string _merchantName = string.Empty;
    private Guid _merchantId;
    private Guid _subcategoryId;
    private Guid _accountId;
    private Guid _cardId;
    private Guid _finalId;
    private decimal _amount;
    private int _installments = 1;
    private string _details = string.Empty;
    private string _month = string.Empty;
    private string _suggestedMonth = string.Empty;
    private string? _message;
    private bool _busy;
    private bool _repeat;
    private string _repeatUntil = string.Empty;
    private Guid? _editingId;
    private Guid? _selectedId;
    private bool _editingInstallment;
    private bool _editingRecurring;
    private RecurringChangeScope? _recurringScope;
    private RecurringChangeScope? _deleteRecurringScope;
    private int _recurringDay;
    private EntryChangeScope? _scope;
    private EntryDetails? _deleteEntry;
    private EntryDetails? _anticipating;
    private async Task AnticipatedAsync() { _anticipating = null; _message = "Parcelas antecipadas."; await ReloadQueryAsync(); }
    private EntryDetails? _effectiveEntry;
    private async Task EffectiveConfirmedAsync() { _effectiveEntry = null; _message = "Baixa registrada."; await ReloadQueryAsync(); }
    private EntryChangeScope? _deleteScope;

    protected override async Task OnInitializedAsync()
    {
        _date = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        _currentMonth = AccountingMonth.FromDate(_date);
        _accounts = await Accounts.GetAccountsAsync();
        _cards = await Accounts.GetCreditCardsAsync();
        _merchants = await Merchants.FindAsync();
        _suggestions = _merchants;
        _subcategories = await Classifications.GetSubcategoriesAsync();
        _people = await People.GetAsync();
        _pageSize = (await Preferences.GetAsync()).PageSize;
        await SuggestMonthAsync();
        await InitializeFiltersAsync();
        await ReloadQueryAsync();
    }
    private async Task DateChangedAsync() { _recurringDay = _date.Day; await SuggestMonthAsync(); }
    private async Task SuggestMonthAsync()
    {
        var suggestion = await Calendar.CalculateAsync(_date, _cardId == Guid.Empty ? null : _cardId);
        if (suggestion.Month is { } month) { _month = month.FirstDay.ToString("yyyy-MM", CultureInfo.InvariantCulture); _suggestedMonth = _month; }
        else { _message = suggestion.Error; }
    }
    private async Task CardChangedAsync()
    {
        _installments = 1;
        _finalId = Guid.Empty;
        _finals = _cardId == Guid.Empty ? [] : await CardDigits.GetAsync(_cardId);
        var card = _cards.FirstOrDefault(x => x.ExternalId == _cardId);
        if (card is not null) { _accountId = card.AccountExternalId; }
        await SuggestMonthAsync();
    }
    private async Task SearchMerchantAsync(ChangeEventArgs args)
    {
        _merchantName = args.Value?.ToString() ?? string.Empty;
        _merchantId = _merchants.FirstOrDefault(x => string.Equals(x.Name, _merchantName, StringComparison.OrdinalIgnoreCase))?.ExternalId ?? Guid.Empty;
        var selected = _merchants.FirstOrDefault(x => x.ExternalId == _merchantId);
        if (selected?.DefaultSubcategoryExternalId is { } subcategory) { _subcategoryId = subcategory; ClassificationChanged(); }
        _suggestions = await Merchants.FindAsync(_merchantName);
    }
    private async Task CreateMerchantAsync()
    {
        if (_busy) { return; }
        _busy = true;
        try
        {
            var result = await Merchants.SaveAsync(null, _merchantName, _subcategoryId == Guid.Empty ? null : _subcategoryId);
            _message = result.Error ?? "Descrição cadastrada. Continue o lançamento.";
            _merchants = await Merchants.FindAsync();
            if (result.Succeeded) { _merchantId = result.ExternalId ?? Guid.Empty; }
        }
        finally { _busy = false; }
    }
    private async Task SaveAsync()
    {
        if (_busy || _savedAttachmentEntry is not null) { return; }
        if (_editingRecurring && _recurringScope is null) { _message = "Escolha o alcance da alteração."; return; }
        if (_editingInstallment && _scope is null) { _message = "Escolha o alcance da alteração."; return; }
        if (!DateOnly.TryParseExact(_month + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var monthDate))
        {
            _message = "Informe um mês contábil válido."; return;
        }
        _busy = true;
        try
        {
            var request = new CreateEntryRequest(_date, _merchantId, _subcategoryId, _accountId, new Money(_amount), _details, AccountingMonth.FromDate(monthDate),
                _cardId == Guid.Empty ? null : _cardId, _finalId == Guid.Empty ? null : _finalId,
                CanHaveReimbursement && _reimbursementPersonId != Guid.Empty ? new(_reimbursementPersonId, _reimbursementPercent) : null);
            AccountingMonth? until = null;
            if (_repeat && _repeatUntil.Length > 0)
            {
                if (!DateOnly.TryParseExact(_repeatUntil + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var endDate))
                {
                    _message = "Informe um término válido para a recorrência."; return;
                }
                until = AccountingMonth.FromDate(endDate);
            }
            var result = _editingId is { } editingId ? _editingRecurring
                ? await Entries.EditRecurringAsync(editingId, new(request, _recurringScope!.Value, _recurringDay))
                : await Entries.EditAsync(editingId, request, _scope ?? EntryChangeScope.OnlyThis)
                : _repeat ? await Entries.CreateRecurringAsync(new(request, until))
                : _installments == 1 ? await Entries.CreateAsync(request) : await Entries.CreateInstallmentsAsync(request, _installments);
            _message = result.Error ?? "Lançamento salvo.";
            if (result.Succeeded)
            {
                var savedId = result.ExternalId!.Value;
                if (_editingId is null && _repeat)
                { savedId = (await Entries.GetAsync()).Where(x => x.RecurringEntryExternalId == savedId).OrderBy(x => x.OccurrenceMonth).First().ExternalId; }
                if (_attachmentPicker?.HasFiles == true) { _savedAttachmentEntry = savedId; await RetryAttachmentsAsync(); }
                Reset(); await ReloadQueryAsync();
            }
        }
        finally { _busy = false; }
    }
    private void Reset()
    {
        _repeat = false; _repeatUntil = string.Empty;
        _editingId = null; _editingInstallment = false; _scope = null; _editingRecurring = false; _recurringScope = null;
        _merchantName = string.Empty; _merchantId = Guid.Empty; _subcategoryId = Guid.Empty; _amount = 0; _details = string.Empty;
        ClearReimbursement();
        _month = _suggestedMonth;
