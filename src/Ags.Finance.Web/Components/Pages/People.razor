@page "/cadastros/pessoas"
@using System.Globalization
@using Ags.Finance.Modules.Imports.Contracts
@using Ags.Finance.Modules.Reimbursements.Contracts
@using Ags.Finance.Web.Components.Layout
@using Ags.Finance.Web.Components.Registries
@inject IPersonCatalog Catalog
@inject IDialogService Dialogs
@inject ViewportState Viewport
@inject ISnackbar Snackbar

<RegistryPage TItem="PersonDetails" Title="Pessoas" Help="Pessoas que podem reembolsar despesas, com o percentual padrão." NewLabel="Nova pessoa" OnNew="() => OpenAsync(null)"
              @bind-Search="_search" Items="Visible" Loaded="_loaded" Message="@_message" OnExternalChange="ReloadAsync" EmptyIcon="@Icons.Material.Outlined.Person" EmptyMessage="Nenhuma pessoa cadastrada. Cadastre a primeira para registrar reembolsos.">
    <MoreActions><RegistryCsvMenu Kinds="s_kinds" /></MoreActions>
    <Columns>
        <MudTh><MudTableSortLabel T="PersonDetails" SortBy="x => x.Name" InitialDirection="SortDirection.Ascending">Nome</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="PersonDetails" SortBy="x => x.DefaultPercent">Percentual padrão</MudTableSortLabel></MudTh>
        <MudTh>Ações</MudTh>
    </Columns>
    <Row Context="person">
        <MudTd DataLabel="Nome"><span class="row-title">@person.Name</span></MudTd>
        <MudTd DataLabel="Percentual padrão" Class="numeric-left">@person.DefaultPercent.ToString("0.##", CultureInfo.GetCultureInfo("pt-BR"))%</MudTd>
        <MudTd DataLabel="Ações" Class="col-actions"><RowActions Actions="ActionsFor(person)" /></MudTd>
    </Row>
</RegistryPage>

@code {
    private static readonly RegistryKind[] s_kinds = [RegistryKind.People];
    private IReadOnlyList<PersonDetails> _people = [];
    private string _search = string.Empty;
    private string? _message;
    private bool _loaded;

    private IReadOnlyList<PersonDetails> Visible => _people.Where(x => x.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase)).ToList();

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _people = await Catalog.GetAsync();
        _loaded = true;
    }

    private async Task ReloadAndRenderAsync()
    {
        await ReloadAsync();
        StateHasChanged();
    }

    private IReadOnlyList<RowAction> ActionsFor(PersonDetails person) =>
    [
        new("Editar", Icons.Material.Outlined.Edit, "edit", EventCallback.Factory.Create(this, () => OpenAsync(person))),
        new("Excluir", Icons.Material.Outlined.Delete, "delete", EventCallback.Factory.Create(this, () => AskDeleteAsync(person))),
    ];

    private async Task OpenAsync(PersonDetails? person)
    {
        var parameters = new DialogParameters<PersonDialog> { { x => x.Person, person }, { x => x.Saved, EventCallback.Factory.Create(this, ReloadAndRenderAsync) } };
        await Dialogs.ShowAsync<PersonDialog>(person is null ? "Nova pessoa" : "Editar pessoa", parameters, AppDialogs.Options(Viewport, MaxWidth.ExtraSmall));
    }

    private async Task AskDeleteAsync(PersonDetails person)
    {
        if (!await ConfirmDialog.AskAsync(Dialogs, "Excluir pessoa", $"{person.Name} será excluída do cadastro. Quem já tem reembolso em lançamentos não pode ser excluído.", "Excluir", destructive: true)) { return; }
        var result = await Catalog.DeleteAsync(person.ExternalId);
        _message = result.Error;
        if (result.Succeeded) { Snackbar.Add("Pessoa excluída.", Severity.Success); }
        await ReloadAsync();
    }
}
