@page "/"
@using Ags.Finance.Modules.Preferences.Contracts
@inject NavigationManager Navigation
@inject IPreferences Preferences

@code {
    // A tela inicial escolhida nas preferências; os endereços diretos das telas continuam funcionando.
    protected override async Task OnInitializedAsync()
    {
        var preferences = await Preferences.GetAsync();
        Navigation.NavigateTo(preferences.StartPage switch
        {
            StartPage.Transactions => "lancamentos",
            StartPage.Invoices => "faturas",
            _ => "dashboard",
        }, replace: true);
    }
}
