@page "/reembolsos"
@using System.Globalization
@using Ags.Finance.Modules.Accounts.Contracts
@using Ags.Finance.Modules.Reimbursements.Contracts
@using Ags.Finance.SharedKernel
@inject IReimbursementOverviews Overviews
@inject IPersonCatalog People
@inject IReimbursementReceipts Receipts
@inject IAccountCatalog Accounts
@inject TimeProvider Clock

<PageHeader Title="Reembolsos" />
@if (_message is not null) { <p role="status">@_message</p> }
<section class="panel">
    <h2>Filtrar reembolsos</h2>
    <form id="reimbursement-filters" @onsubmit="LoadAsync" @onsubmit:preventDefault>
        <div class="catalog-fields">
            <div class="field"><label for="reimbursement-month">Mês contábil</label><input id="reimbursement-month" type="month" value="@_month" @onchange="args => _month = args.Value?.ToString() ?? string.Empty" disabled="@_allMonths" /></div>
            <div class="field"><label for="reimbursement-person">Pessoa</label><select id="reimbursement-person" @bind="_personId">
                <option value="@Guid.Empty">Todas</option>@foreach (var person in _people) { <option value="@person.ExternalId">@person.Name</option> }
            </select></div>
            <div class="field"><label for="reimbursement-status">Situação</label><select id="reimbursement-status" @bind="_status">
                <option value="">Todas</option><option value="@ReimbursementStatus.Pending">Pendente</option><option value="@ReimbursementStatus.Received">Recebido</option>
            </select></div>
        </div>
        <label class="checkbox"><input id="reimbursement-all-months" type="checkbox" @bind="_allMonths" />Todos os meses</label>
        <button class="button" disabled="@_busy">Filtrar</button>
    </form>
    @if (!_overview.PendingBeforeMonth.IsZero)
    {
        <p class="reimbursement-warning" role="note">Há <span class="numeric">@_overview.PendingBeforeMonth</span> pendentes em meses anteriores. Marque "Todos os meses" para vê-los.</p>
    }
</section>
@if (_receiving)
{
    <section class="panel" role="dialog" aria-label="Efetivar recebimento">
        <h2>Efetivar recebimento</h2>
        <div class="catalog-fields">
            <div class="field"><label for="receipt-date">Data</label><input id="receipt-date" type="date" @bind="_receiptDate" required /></div>
            <div class="field"><label for="receipt-account">Conta corrente</label><select id="receipt-account" @bind="_receiptAccount">
                <option value="@Guid.Empty">Selecione</option>@foreach (var account in _accounts) { <option value="@account.ExternalId">@account.Name</option> }
            </select></div>
        </div>
        <ul class="catalog-list" aria-label="Valores recebidos">
            @foreach (var item in SelectedItems)
            {
                <li><span>@item.PersonName · @item.Description · Esperado: <span class="numeric">@item.Expected</span></span>
                    <div class="field"><label for="received-@item.EntryExternalId">Valor recebido (R$)</label><input id="received-@item.EntryExternalId" type="number" step="0.01" min="0" @bind="_received[item.EntryExternalId]" required /></div></li>
            }
        </ul>
        <ul class="catalog-list" aria-label="Receitas que serão criadas">
            @foreach (var person in SelectedItems.GroupBy(x => x.PersonName).OrderBy(x => x.Key, StringComparer.CurrentCultureIgnoreCase))
            {
                var total = new Money(person.Sum(x => _received[x.EntryExternalId]));
                <li><span>@person.Key: <span class="numeric">@total</span> · @(total.IsZero ? "sem lançamento" : "uma receita na conta escolhida")</span></li>
            }
        </ul>
        <button class="button" @onclick="ConfirmReceiveAsync" disabled="@_busy">Confirmar recebimento</button>
        <button class="button" @onclick="() => _receiving = false" disabled="@_busy">Cancelar</button>
    </section>
}
<section class="panel">
    <h2>Reembolsos</h2>
    @if (_overview.Items.Any(x => x.Status == ReimbursementStatus.Pending))
    {
        <label class="checkbox"><input id="reimbursement-select-all" type="checkbox" checked="@AllPendingSelected" @onchange="ToggleAll" />Selecionar todos os pendentes</label>
        <button class="button" id="reimbursement-receive" @onclick="StartReceive" disabled="@(_selected.Count == 0 || _busy)">Efetivar selecionados (@_selected.Count)</button>
    }
    <ul class="catalog-list" aria-label="Reembolsos">
        @foreach (var item in _overview.Items)
        {
            <li>
                @if (item.Status == ReimbursementStatus.Pending)
                {
                    <label class="checkbox"><input type="checkbox" aria-label="Selecionar @item.Description de @item.PersonName" checked="@_selected.Contains(item.EntryExternalId)" @onchange="args => Toggle(item.EntryExternalId, args)" />Selecionar</label>
                }
                <span>@item.Date.ToString("dd/MM/yyyy") · @item.Description · @item.Classification · Mês @item.Month</span>
                <span>@item.PersonName · @item.ExpenseAmount × @Percent(item.Percent)</span>
                @if (!item.IsExpenseEffective) { <span>Despesa ainda pendente</span> }
                <span>Esperado: <span class="numeric">@item.Expected</span></span>
                <span>Recebido: <span class="numeric">@(item.Received is { } received ? received.ToString() : "—")</span></span>
                <span>@(item.ReceivedDate is { } receivedDate ? $"Recebido em {receivedDate:dd/MM/yyyy}" : "Pendente")</span>
            </li>
        }
    </ul>
    @if (_overview.Items.Count == 0 && !_busy) { <p>Nenhum reembolso neste filtro.</p> }
    @if (_overview.Items.Count > 0)
    {
        <footer aria-label="Totais dos reembolsos">
            <p>Esperado: <span class="numeric">@_overview.Expected</span></p>
            <p>Recebido: <span class="numeric">@_overview.Received</span></p>
            <p>Pendente: <span class="numeric">@_overview.Pending</span></p>
            <ul class="catalog-list" aria-label="Totais por pessoa">
                @foreach (var total in _overview.People)
                {
                    <li><span>@total.PersonName</span>
                        <span>Esperado: <span class="numeric">@total.Expected</span></span>
                        <span>Recebido: <span class="numeric">@total.Received</span></span>
                        <span>Pendente: <span class="numeric">@total.Pending</span></span></li>
                }
            </ul>
        </footer>
    }
</section>

@code {
    private IReadOnlyList<PersonDetails> _people = [];
    private ReimbursementOverview _overview = new([], [], default, default, default, default);
    private string _month = string.Empty;
    private Guid _personId;
    private ReimbursementStatus? _status;
    private bool _allMonths;
    private bool _busy;
    private string? _message;
    private IReadOnlyList<AccountDetails> _accounts = [];
    private readonly HashSet<Guid> _selected = [];
    private readonly Dictionary<Guid, decimal> _received = [];
    private bool _receiving;
    private DateOnly _receiptDate;
    private Guid _receiptAccount;

    private IEnumerable<ReimbursementItem> SelectedItems => _overview.Items.Where(x => _selected.Contains(x.EntryExternalId));
    private bool AllPendingSelected => _overview.Items.Where(x => x.Status == ReimbursementStatus.Pending).All(x => _selected.Contains(x.EntryExternalId));

    protected override async Task OnInitializedAsync()
    {
        _month = Clock.GetLocalNow().ToString("yyyy-MM", CultureInfo.InvariantCulture);
        _people = await People.GetAsync();
        _accounts = (await Accounts.GetAccountsAsync()).Where(x => x.Kind == AccountKind.Checking).ToList();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        AccountingMonth? month = null;
        if (!_allMonths)
        {
            if (!DateOnly.TryParseExact(_month + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)) { _message = "Informe um mês contábil válido."; return; }
            month = AccountingMonth.FromDate(date);
        }
        _busy = true;
        try
        {
            _overview = await Overviews.GetAsync(new(month, _personId == Guid.Empty ? null : _personId, _status));
            _message = _overview.Error;
            _selected.IntersectWith(_overview.Items.Where(x => x.Status == ReimbursementStatus.Pending).Select(x => x.EntryExternalId));
            _receiving = false;
        }
        finally { _busy = false; }
    }

    private void Toggle(Guid entry, ChangeEventArgs args)
    {
        if (args.Value is true) { _selected.Add(entry); }
        else { _selected.Remove(entry); }
    }

    private void ToggleAll(ChangeEventArgs args)
    {
        _selected.Clear();
        if (args.Value is true) { _selected.UnionWith(_overview.Items.Where(x => x.Status == ReimbursementStatus.Pending).Select(x => x.EntryExternalId)); }
    }

    private void StartReceive()
    {
        _receiptDate = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        _received.Clear();
        foreach (var item in SelectedItems) { _received[item.EntryExternalId] = decimal.Parse(item.Expected.Amount.ToString("0.##", CultureInfo.InvariantCulture), CultureInfo.InvariantCulture); }
        _receiving = true;
    }

    private async Task ConfirmReceiveAsync()
    {
        if (_busy) { return; }
        _busy = true;
        try
        {
            var items = SelectedItems.Select(x => new ReceiveReimbursementItem(x.EntryExternalId, x.Expected, new Money(_received[x.EntryExternalId]))).ToList();
            var result = await Receipts.ReceiveAsync(new(_receiptDate, _receiptAccount == Guid.Empty ? null : _receiptAccount, items));
            _message = result.Error ?? "Recebimento efetivado.";
            if (!result.Succeeded) { return; }
            _selected.Clear();
        }
        finally { _busy = false; }
        await LoadAsync();
    }

    private static string Percent(decimal value) => value.ToString("0.##", CultureInfo.GetCultureInfo("pt-BR")) + "%";
}
