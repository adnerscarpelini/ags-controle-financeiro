@page "/reembolsos"
@using System.Globalization
@using Ags.Finance.Modules.Accounts.Contracts
@using Ags.Finance.Modules.Reimbursements.Contracts
@using Ags.Finance.SharedKernel
@using Ags.Finance.Web.Components.Layout
@using Ags.Finance.Web.Components.Registries
@inject IReimbursementOverviews Overviews
@inject IPersonCatalog People
@inject IReimbursementReceipts Receipts
@inject IAccountCatalog Accounts
@inject TimeProvider Clock
@inject IDialogService Dialogs
@inject ViewportState Viewport
@inject ISnackbar Snackbar

<div class="page-head">
    <PageHeader Title="Reembolsos" />
    <HelpTip Text="Quanto cada pessoa deve devolver das despesas. Pendente é calculado na leitura; só o recebimento é gravado e pode ser desfeito." />
    <div class="page-head-actions">
        <MudTooltip Text="Filtrar por pessoa, situação e todos os meses">
            <MudIconButton Icon="@Icons.Material.Outlined.FilterList" Variant="Variant.Outlined" aria-label="Filtros" aria-expanded="@(_filtersOpen ? "true" : "false")" data-toggle-filters OnClick="() => _filtersOpen = !_filtersOpen" />
        </MudTooltip>
        <MudButton id="reimbursement-receive" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_selected.Count == 0 || _busy)" OnClick="OpenReceiveAsync">Registrar recebimento (@_selected.Count)</MudButton>
    </div>
</div>

@if (_message is not null) { <p class="form-error" role="alert" data-reimbursement-error>@_message</p> }

@if (_filtersOpen)
{
    <section class="panel filters-panel" aria-label="Filtros">
        <form id="reimbursement-filters" class="catalog-fields" @onsubmit="LoadAsync" @onsubmit:preventDefault>
            <div class="field"><label for="reimbursement-person">Pessoa</label><select id="reimbursement-person" class="input" @bind="_personId" @bind:after="LoadAsync">
                <option value="@Guid.Empty">Todas</option>@foreach (var person in _people) { <option value="@person.ExternalId">@person.Name</option> }
            </select></div>
            <div class="field"><label for="reimbursement-status">Situação</label><select id="reimbursement-status" class="input" @bind="_status" @bind:after="LoadAsync">
                <option value="">Todas</option><option value="@ReimbursementStatus.Pending">Pendente</option><option value="@ReimbursementStatus.Received">Recebido</option>
            </select></div>
            <div class="field"><label for="reimbursement-all-months">Todos os meses</label><input id="reimbursement-all-months" class="switch" type="checkbox" role="switch" @bind="_allMonths" @bind:after="LoadAsync" /></div>
        </form>
    </section>
}

@if (!_overview.PendingBeforeMonth.IsZero)
{
    <p class="form-warning" role="note">Há <span class="numeric">@_overview.PendingBeforeMonth</span> pendentes em meses anteriores. Ligue "Todos os meses" nos filtros para vê-los.</p>
}

<section class="stat-cards" aria-label="Totais dos reembolsos">
    <StatCard ValueClass="@ValueColor.Income(_overview.Expected)" Label="Esperado" Help="Soma do que as pessoas devem devolver no filtro atual." Value="@_overview.Expected.ToString()" Testid="expected" />
    <StatCard ValueClass="@ValueColor.Income(_overview.Received)" Label="Recebido" Value="@_overview.Received.ToString()" Testid="received" />
    <StatCard ValueClass="@ValueColor.Income(_overview.Pending)" Label="Pendente" Value="@_overview.Pending.ToString()" Testid="pending" />
</section>

<section class="panel data-panel">
    <MonthPicker Value="_month" ValueChanged="MonthChangedAsync" Disabled="_allMonths" />
    <MudTable T="ReimbursementItem" Items="_overview.Items" Elevation="0" Hover="true" Class="data-table" Breakpoint="AppTables.Breakpoint(IsMobile)" SortLabel="@AppTables.SortLabel" aria-label="Reembolsos">
        <HeaderContent>
            <MudTh Class="col-select">
                @if (HasPending)
                {
                    <input id="reimbursement-select-all" type="checkbox" class="row-select" aria-label="Selecionar todos os pendentes" checked="@AllPendingSelected" @onchange="ToggleAll" />
                }
            </MudTh>
            <MudTh>Despesa</MudTh>
            <MudTh>Pessoa</MudTh>
            <MudTh Class="numeric">Valor da conta</MudTh>
            <MudTh>Percentual</MudTh>
            <MudTh Class="numeric">A receber</MudTh>
            <MudTh Class="numeric">Recebido</MudTh>
            <MudTh>Situação</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate Context="item">
            <MudTd Class="col-select">
                @if (item.Status == ReimbursementStatus.Pending)
                {
                    <input type="checkbox" class="row-select" aria-label="Selecionar @item.Description de @item.PersonName" checked="@_selected.Contains(item.EntryExternalId)" @onchange="args => Toggle(item.EntryExternalId, args)" />
                }
            </MudTd>
            <MudTd DataLabel="Despesa" Class="col-description">
                <span class="row-title">@item.Description</span>
                <span class="row-note">@item.Date.ToString("dd/MM/yyyy") · @item.Classification.Replace(" > ", " › ", StringComparison.Ordinal) · Mês @item.Month@(item.IsExpenseEffective ? string.Empty : " · Despesa ainda pendente")</span>
            </MudTd>
            <MudTd DataLabel="Pessoa">@item.PersonName</MudTd>
            <MudTd DataLabel="Valor da conta" Class="@($"numeric {ValueColor.Neutral}")" data-expense-amount>@item.ExpenseAmount</MudTd>
            <MudTd DataLabel="Percentual">@Percent(item.Percent)</MudTd>
            <MudTd DataLabel="A receber" Class="@($"numeric {ValueColor.Income(item.Expected)}")">@item.Expected</MudTd>
            <MudTd DataLabel="Recebido" Class="@($"numeric {(item.Received is { } amount ? ValueColor.Income(amount) : ValueColor.Neutral)}")">@(item.Received is { } received ? received.ToString() : "—")</MudTd>
            <MudTd DataLabel="Situação"><span class="tag">@(item.ReceivedDate is { } receivedDate ? $"Recebido em {receivedDate:dd/MM/yyyy}" : "Pendente")</span></MudTd>
            <MudTd DataLabel="Ações" Class="col-actions">
                @if (item.ReceiptExternalId is { } receipt)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" data-undo-receipt Disabled="@_busy" OnClick="() => AskUndoAsync(receipt)">Desfazer recebimento</MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <EmptyState Icon="@Icons.Material.Outlined.Replay" Message="Nenhum reembolso neste filtro. Informe a pessoa e o percentual em uma despesa para acompanhar aqui." />
        </NoRecordsContent>
    </MudTable>
    @if (_overview.People.Count > 0)
    {
        <footer class="table-footer" aria-label="Totais por pessoa">
            @foreach (var total in _overview.People)
            {
                <span data-person-total>@total.PersonName · Esperado: @total.Expected · Recebido: @total.Received · Pendente: @total.Pending</span>
            }
        </footer>
    }
</section>

@code {
    [CascadingParameter(Name = "IsMobile")]
    public bool IsMobile { get; set; }

    private IReadOnlyList<PersonDetails> _people = [];
    private ReimbursementOverview _overview = new([], [], default, default, default, default);
    private ReferenceMonth _month;
    private Guid _personId;
    private ReimbursementStatus? _status;
    private bool _allMonths;
    private bool _filtersOpen;
    private bool _busy;
    private string? _message;
    private readonly HashSet<Guid> _selected = [];
    private IReadOnlyList<AccountDetails> _allAccounts = [];

    private string AccountName(Guid externalId) => _allAccounts.FirstOrDefault(x => x.ExternalId == externalId)?.Name ?? "selecionada";

    private IEnumerable<ReimbursementItem> SelectedItems => _overview.Items.Where(x => _selected.Contains(x.EntryExternalId));

    private bool HasPending => _overview.Items.Any(x => x.Status == ReimbursementStatus.Pending);

    private bool AllPendingSelected => _overview.Items.Where(x => x.Status == ReimbursementStatus.Pending).All(x => _selected.Contains(x.EntryExternalId));

    protected override async Task OnInitializedAsync()
    {
        _month = ReferenceMonth.FromDate(DateOnly.FromDateTime(Clock.GetLocalNow().DateTime));
        _people = await People.GetAsync();
        _allAccounts = await Accounts.GetAccountsAsync(false);
        await LoadAsync();
    }

    private async Task MonthChangedAsync(ReferenceMonth month)
    {
        _month = month;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _overview = await Overviews.GetAsync(new(_allMonths ? null : _month, _personId == Guid.Empty ? null : _personId, _status));
            _message = _overview.Error;
            _selected.IntersectWith(_overview.Items.Where(x => x.Status == ReimbursementStatus.Pending).Select(x => x.EntryExternalId));
        }
        finally { _busy = false; }
    }

    private void Toggle(Guid entry, ChangeEventArgs args)
    {
        if (args.Value is true) { _selected.Add(entry); }
        else { _selected.Remove(entry); }
    }

    private void ToggleAll(ChangeEventArgs args)
    {
        _selected.Clear();
        if (args.Value is true) { _selected.UnionWith(_overview.Items.Where(x => x.Status == ReimbursementStatus.Pending).Select(x => x.EntryExternalId)); }
    }

    private async Task OpenReceiveAsync()
    {
        var parameters = new DialogParameters<ReimbursementReceiptDialog>
        {
            { x => x.Items, SelectedItems.ToList() },
            { x => x.Accounts, _allAccounts.Where(x => x.IsActive && x.Kind == AccountKind.Checking).ToList() },
            { x => x.Received, EventCallback.Factory.Create(this, ReceivedAsync) },
        };
        await Dialogs.ShowAsync<ReimbursementReceiptDialog>("Registrar recebimento", parameters, AppDialogs.Options(Viewport, MaxWidth.Medium));
    }

    private async Task ReceivedAsync()
    {
        _selected.Clear();
        await LoadAsync();
    }

    private async Task AskUndoAsync(Guid receipt)
    {
        var undoing = await Receipts.FindAsync(receipt);
        if (undoing is null)
        {
            _message = "Este recebimento não existe mais.";
            await LoadAsync();
            return;
        }

        var effect = undoing.AccountExternalId is { } account ? $"A receita será excluída da conta {AccountName(account)}." : "Este recebimento não gerou lançamento.";
        var confirmed = await ConfirmDialog.AskAsync(Dialogs, "Desfazer recebimento",
            $"{undoing.PersonName} · {undoing.Date:dd/MM/yyyy} · {undoing.Total}. {effect} Todos estes itens voltam a Pendente:", "Desfazer recebimento",
            details: undoing.Items.Select(x => $"{x.Date:dd/MM/yyyy} · {x.Description} · Mês {x.Month} · Esperado: {x.Expected} · Recebido: {x.Received}").ToList(), detailsLabel: "Itens do recebimento");
        if (!confirmed) { return; }
        _busy = true;
        try
        {
            var result = await Receipts.UndoAsync(undoing.ExternalId);
            _message = result.Error;
            if (result.Succeeded) { Snackbar.Add("Recebimento desfeito. Os itens voltaram a Pendente.", Severity.Success); }
        }
        finally { _busy = false; }
        await LoadAsync();
    }

    private static string Percent(decimal value) => value.ToString("0.##", CultureInfo.GetCultureInfo("pt-BR")) + "%";
}
