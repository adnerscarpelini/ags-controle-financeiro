@page "/backups"
@using Ags.Finance.Web.Backup
@inject BackupService Service
@inject BackupSettings Settings
@inject BackupStatus Status
@inject RestoreCoordinator Coordinator

<div class="page-head">
    <PageHeader Title="Backup e restauração" />
    <HelpTip Text="Cópia completa para recuperar os dados. Guarde a pasta de backup fora desta máquina: o volume sozinho não protege contra a perda do computador." />
    <div class="page-head-actions">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Backup" data-create-backup Disabled="@(_busy || Settings.Directory is null)" OnClick="CreateAsync">Criar backup</MudButton>
    </div>
</div>

@if (Settings.Directory is null)
{
    <p class="form-error" role="alert">A pasta de backup não está configurada (Backup:Directory).</p>
}
else
{
    <p class="form-note">
        Backup diário às @Settings.ScheduleTime.ToString("HH:mm") (@(Settings.ScheduleEnabled ? "ativo" : "desativado")),
        com retenção de @Settings.RetentionDays backups e um backup mensal sempre preservado.
    </p>
    <p class="form-note" data-testid="backup-last">@LastResultText()</p>
}

@if (_message is not null)
{
    <p class="@(_failed ? "form-error" : "form-success")" role="status" data-testid="backup-message">@_message</p>
}

@if (_pendingRestore is not null)
{
    <section class="panel notice" role="alertdialog" aria-label="Confirmar restauração">
        <p>
            A restauração <strong>substitui todos os dados atuais</strong> pelos do backup @_pendingRestore.Name.
            Antes, um backup do estado atual é feito por segurança.
        </p>
        <p>
            Enquanto ela acontece, a aplicação fica em manutenção: ninguém consegue usar as telas até terminar.
            Depois a aplicação reinicia sozinha, e será preciso entrar de novo.
        </p>
        <div class="field">
            <label for="restore-confirmation">Digite o nome do backup para confirmar</label>
            <input id="restore-confirmation" class="input" @bind="_confirmation" @bind:event="oninput" autocomplete="off" />
        </div>
        <div class="filters-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Error" data-confirm-restore Disabled="@(_busy || _confirmation.Trim() != _pendingRestore.Name)" OnClick="RestoreAsync">Restaurar este backup</MudButton>
            <MudButton data-cancel-restore Disabled="@_busy" OnClick="CancelRestore">Cancelar</MudButton>
        </div>
    </section>
}

<section class="panel data-panel">
    <MudTable T="BackupPackage" Items="_packages" Elevation="0" Hover="true" Class="data-table" Breakpoint="Breakpoint.Sm" aria-label="Backups disponíveis">
        <HeaderContent>
            <MudTh>Pacote</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh Class="numeric">Tamanho</MudTh>
            <MudTh>PostgreSQL</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate Context="package">
            <MudTd DataLabel="Pacote"><span class="row-title">@package.Manifest.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span><span class="row-note">@package.Name</span></MudTd>
            <MudTd DataLabel="Tipo">@KindLabel(package.Manifest.Kind)@(package.Manifest.Monthly ? " · mensal" : string.Empty)</MudTd>
            <MudTd DataLabel="Tamanho" Class="numeric">@FormatSize(package.Manifest)</MudTd>
            <MudTd DataLabel="PostgreSQL">@package.Manifest.PostgresServerVersion</MudTd>
            <MudTd DataLabel="Ações" Class="col-actions"><MudButton Variant="Variant.Outlined" Size="Size.Small" data-restore Disabled="@_busy" OnClick="() => AskRestore(package)">Restaurar</MudButton></MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <EmptyState Icon="@Icons.Material.Outlined.Backup" Message="Nenhum backup encontrado. Crie o primeiro para proteger seus dados." />
        </NoRecordsContent>
    </MudTable>
</section>

@code {
    private IReadOnlyList<BackupPackage> _packages = [];
    private BackupPackage? _pendingRestore;
    private string _confirmation = string.Empty;
    private string? _message;
    private bool _failed;
    private bool _busy;

    protected override void OnInitialized()
    {
        _packages = Service.List();
    }

    private async Task CreateAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            var result = await Service.CreateAsync(BackupService.KindManual, CancellationToken.None);
            Status.Record(result, TimeProvider.System.GetUtcNow());
            _failed = !result.Succeeded;
            _message = result.Succeeded ? $"Backup concluído: {result.Package!.Name}." : $"O backup falhou: {result.Error}";
            if (result.Succeeded)
            {
                await Service.ApplyRetentionAsync(CancellationToken.None);
            }
        }
        finally
        {
            _busy = false;
            _packages = Service.List();
        }
    }

    private void AskRestore(BackupPackage package)
    {
        _pendingRestore = package;
        _confirmation = string.Empty;
        _message = null;
    }

    private void CancelRestore()
    {
        _pendingRestore = null;
    }

    private async Task RestoreAsync()
    {
        if (_pendingRestore is null || _confirmation.Trim() != _pendingRestore.Name)
        {
            return;
        }

        _busy = true;
        _message = "Restauração em andamento. A aplicação está em manutenção e reiniciará ao terminar.";
        _failed = false;
        StateHasChanged();
        try
        {
            var result = await Coordinator.RestoreAsync(_pendingRestore.Name, CancellationToken.None);
            _failed = !result.Succeeded;
            _message = result.Succeeded
                ? "Restauração concluída. A aplicação está reiniciando; entre novamente em instantes."
                : $"A restauração falhou: {result.Error}";
            if (!result.Succeeded)
            {
                _busy = false;
            }
        }
        finally
        {
            _pendingRestore = null;
            _packages = Service.List();
        }
    }

    private string LastResultText()
    {
        if (Status.LastError is not null)
        {
            return $"O último backup falhou: {Status.LastError}";
        }

        var latest = _packages.Count > 0 ? _packages[0].Manifest.CreatedAt : (DateTimeOffset?)null;
        return latest is null ? "Nenhum backup concluído ainda." : $"Último backup concluído em {latest.Value.ToLocalTime():dd/MM/yyyy HH:mm}.";
    }

    private static string KindLabel(string kind) => kind switch
    {
        BackupService.KindManual => "manual",
        BackupService.KindScheduled => "agendado",
        BackupService.KindPreRestore => "antes de restaurar",
        BackupService.KindPreUpdate => "antes de atualizar",
        _ => kind,
    };

    private static string FormatSize(BackupManifest manifest)
    {
        var kib = manifest.Files.Sum(file => file.Bytes) / 1024.0;
        return kib >= 1024 ? $"{kib / 1024:0.0} MiB" : $"{kib:0} KiB";
    }
}
