@page "/faturas"
@using Ags.Finance.Modules.Invoices.Contracts
@using Ags.Finance.SharedKernel
@using System.Globalization
@using Ags.Finance.Modules.Accounts.Contracts
@inject IInvoiceCatalog Catalog
@inject IInvoiceLifecycle Lifecycle
@inject IAccountCatalog Accounts
@inject TimeProvider Clock

<PageHeader Title="Faturas" />
<section class="panel">
    <h2>Consultar mês</h2>
    <form id="invoice-filter" @onsubmit="ReloadInvoicesAsync" @onsubmit:preventDefault>
        <div class="field"><label for="invoice-view-month">Mês contábil (vazio para todos os registrados)</label><input id="invoice-view-month" type="month" value="@_viewMonth" @onchange="args => _viewMonth = args.Value?.ToString() ?? string.Empty" /></div>
        <button class="button" disabled="@_busy">Consultar</button>
    </form>
</section>
@if (_message is not null) { <p role="status">@_message</p> }
@if (_pending is { } pending)
{
    <section class="panel" role="alertdialog" aria-label="Confirmar situação da fatura">
        <h2>@(_reopen ? "Reabrir fatura" : "Fechar fatura")</h2>
        <p>@pending.CardName · @pending.Month · Total @pending.Total</p>
        <p>@(_reopen ? "A fatura ficará Aberta até novo fechamento manual. Pagamentos confirmados impedem a reabertura." : "Fechar protege as compras, sem registrar pagamento. Saldo zero ou crédito não marca a fatura como Paga.")</p>
        <button class="button" @onclick="ConfirmAsync" disabled="@_busy">Confirmar</button>
        <button class="button" @onclick="() => _pending = null" disabled="@_busy">Cancelar</button>
    </section>
}
<section class="panel">
    <h2>Fechar uma fatura</h2>
    <form @onsubmit="AskManualClose" @onsubmit:preventDefault>
        <div class="catalog-fields">
            <div class="field"><label for="invoice-card">Cartão</label><select id="invoice-card" @bind="_cardId" required>
                <option value="@Guid.Empty">Selecione</option>
                @foreach (var card in _cards) { <option value="@card.ExternalId">@card.Name</option> }
            </select></div>
            <div class="field"><label for="invoice-month">Mês contábil</label><input id="invoice-month" type="month" value="@_month" @onchange="args => _month = args.Value?.ToString() ?? string.Empty" required /></div>
        </div>
        <button class="button">Revisar fechamento</button>
    </form>
</section>
<section class="panel">
    <h2>Por cartão e mês contábil</h2>
    @if (_invoices.Count == 0) { <p>Nenhuma fatura registrada.</p> }
    <ul class="catalog-list">
        @foreach (var invoice in _invoices)
        {
            <li><span>@invoice.CardName · @invoice.Month</span><span class="numeric">@invoice.Total</span>
                <span>@StatusLabel(invoice.Status)</span>
                <button class="button" @onclick="() => Select(invoice)">Ver composição</button>
                @if (invoice.Status == InvoiceStatus.Open) { <button class="button" @onclick="() => Ask(invoice, false)">Fechar</button> }
                @if (invoice.Status == InvoiceStatus.Closed) { <button class="button" @onclick="() => Ask(invoice, true)">Reabrir</button> }
            </li>
        }
    </ul>
</section>
@if (_invoices.FirstOrDefault(x => x.CardExternalId == _selectedCard && x.Month == _selectedMonth) is { } selected)
{
    <section class="panel" aria-label="Composição da fatura">
        <h2>@selected.CardName · @selected.Month</h2>
        <p>Situação: @StatusLabel(selected.Status)</p>
        <ul class="catalog-list">
            @foreach (var entry in selected.Entries)
            {
                <li><span>@entry.Date.ToString("dd/MM/yyyy") · @entry.MerchantName · @entry.Classification</span>
                    <span class="numeric entry-expense">@entry.Amount</span><span>@entry.Details</span>
                    @if (entry.InstallmentNumber is not null) { <span>Parcela @entry.InstallmentNumber/@entry.InstallmentCount</span> }
                    @if (entry.RecurringEntryExternalId is not null) { <span>Recorrente @(entry.Date > DateOnly.FromDateTime(Clock.GetLocalNow().DateTime) ? "· prevista" : string.Empty)</span> }
                </li>
            }
        </ul>
        <p>Total: <span class="numeric">@selected.Total</span></p>
    </section>
}

@code {
    private IReadOnlyList<InvoiceDetails> _invoices = [];
    private IReadOnlyList<CreditCardDetails> _cards = [];
    private InvoiceDetails? _pending;
    private bool _reopen;
    private bool _busy;
    private string? _message;
    private Guid _cardId;
    private string _month = string.Empty;
    private string _viewMonth = string.Empty;
    private Guid? _selectedCard;
    private AccountingMonth? _selectedMonth;
    protected override async Task OnInitializedAsync()
    {
        _month = Clock.GetLocalNow().ToString("yyyy-MM", CultureInfo.InvariantCulture);
        _cards = await Accounts.GetCreditCardsAsync(false);
        await ReloadInvoicesAsync();
    }
    private void Select(InvoiceDetails invoice) { _selectedCard = invoice.CardExternalId; _selectedMonth = invoice.Month; }
    private void Ask(InvoiceDetails invoice, bool reopen) { _pending = invoice; _reopen = reopen; }
    private void AskManualClose()
    {
        var card = _cards.FirstOrDefault(x => x.ExternalId == _cardId);
        if (card is null || !DateOnly.TryParseExact(_month + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _message = "Selecione cartão e mês válidos."; return;
        }
        var month = AccountingMonth.FromDate(date);
        Ask(_invoices.FirstOrDefault(x => x.CardExternalId == card.ExternalId && x.Month == month) ?? new(card.ExternalId, card.Name, month, Money.Zero, []), false);
    }
    private async Task ConfirmAsync()
    {
        if (_pending is not { } pending || _busy) { return; }
        _busy = true;
        try
        {
            var result = _reopen ? await Lifecycle.ReopenAsync(pending.CardExternalId, pending.Month) : await Lifecycle.CloseAsync(pending.CardExternalId, pending.Month);
            _message = result.Error ?? "Situação atualizada.";
            _pending = null;
            await ReloadInvoicesAsync();
        }
        finally { _busy = false; }
    }
    private static string StatusLabel(InvoiceStatus status) => status switch { InvoiceStatus.Closed => "Fechada", InvoiceStatus.Paid => "Paga", _ => "Aberta" };
    private async Task ReloadInvoicesAsync()
    {
        if (_viewMonth.Length == 0) { _invoices = await Catalog.GetAsync(); return; }
        if (!DateOnly.TryParseExact(_viewMonth + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _message = "Informe um mês válido para consulta."; return;
        }
        _invoices = await Catalog.GetMonthAsync(AccountingMonth.FromDate(date));
    }
}
