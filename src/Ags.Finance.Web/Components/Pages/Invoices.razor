@page "/faturas"
@using Ags.Finance.Modules.Invoices.Contracts
@using Ags.Finance.SharedKernel
@using System.Globalization
@using Ags.Finance.Modules.Accounts.Contracts
@inject IInvoiceCatalog Catalog
@inject IInvoiceLifecycle Lifecycle
@inject IAccountCatalog Accounts
@inject TimeProvider Clock
@inject IInvoicePaymentCatalog Payments

<PageHeader Title="Faturas" />
<p><a href="/compromissos">Saldos de faturas e parcelas futuras</a></p>
<section class="panel">
    <h2>Consultar mês</h2>
    <form id="invoice-filter" @onsubmit="ReloadInvoicesAsync" @onsubmit:preventDefault>
        <div class="field"><label for="invoice-view-month">Mês contábil (vazio para todos os registrados)</label><input id="invoice-view-month" type="month" value="@_viewMonth" @onchange="args => _viewMonth = args.Value?.ToString() ?? string.Empty" /></div>
        <button class="button" disabled="@_busy">Consultar</button>
    </form>
</section>
@if (_message is not null) { <p role="status">@_message</p> }
@if (_adjusting is { } adjusting) { <InvoiceTotalAdjustmentDialog @key="adjusting" Invoice="adjusting" Confirmed="AdjustmentConfirmedAsync" Cancelled="() => _adjusting = null" /> }
@if (_paying is { } paying) { <InvoicePaymentDialog @key="paying" Invoice="paying" Confirmed="PaymentConfirmedAsync" PaymentRecorded="ReloadInvoicesAsync" Cancelled="ClosePaymentAsync" /> }
@if (_attachmentInvoice is { } documents) { <InvoiceAttachments @key="documents" CardExternalId="documents.CardExternalId" Month="documents.Month" /> }
@if (_settling is { } settling)
{
    <section class="panel" role="alertdialog" aria-label="Confirmar quitação">
        <h2>Confirmar quitação sem novo débito</h2><p>@settling.CardName · @settling.Month · Saldo restante @settling.RemainingBalance</p>
        <p>A fatura passará a Paga. Nenhum pagamento ou débito zero será criado.</p>
        <button class="button" @onclick="SettleAsync" disabled="@_busy">Confirmar quitação</button><button class="button" @onclick="() => _settling = null" disabled="@_busy">Cancelar</button>
    </section>
}
@if (_pending is { } pending)
{
    <section class="panel" role="alertdialog" aria-label="Confirmar situação da fatura">
        <h2>@(_reopen ? "Reabrir fatura" : "Fechar fatura")</h2>
        <p>@pending.CardName · @pending.Month · Total @pending.ProjectedTotal@(pending.ForecastEntries.Count > 0 ? " (inclui " + pending.ForecastTotal + " em recorrentes previstas)" : string.Empty)</p>
        <p>@(_reopen ? "A fatura ficará Aberta até novo fechamento manual. Pagamentos confirmados impedem a reabertura." : "Fechar protege todas as compras, inclusive as recorrentes previstas, sem registrar pagamento. Saldo zero ou crédito não marca a fatura como Paga.")</p>
        <button class="button" @onclick="ConfirmAsync" disabled="@_busy">Confirmar</button>
        <button class="button" @onclick="() => _pending = null" disabled="@_busy">Cancelar</button>
    </section>
}
<section class="panel">
    <h2>Fechar uma fatura</h2>
    <form @onsubmit="AskManualClose" @onsubmit:preventDefault>
        <div class="catalog-fields">
            <div class="field"><label for="invoice-card">Cartão</label><select id="invoice-card" @bind="_cardId" required>
                <option value="@Guid.Empty">Selecione</option>
                @foreach (var card in _cards) { <option value="@card.ExternalId">@card.Name</option> }
            </select></div>
            <div class="field"><label for="invoice-month">Mês contábil</label><input id="invoice-month" type="month" value="@_month" @onchange="args => _month = args.Value?.ToString() ?? string.Empty" required /></div>
        </div>
        <button class="button">Revisar fechamento</button>
    </form>
</section>
<section class="panel">
    <h2>Por cartão e mês contábil</h2>
    @if (_invoices.Count == 0) { <p>Nenhuma fatura registrada.</p> }
    <ul class="catalog-list">
        @foreach (var invoice in _invoices)
        {
            <li><span>@invoice.CardName · @invoice.Month</span><span class="numeric">@invoice.Total</span>
                @if (invoice.ForecastEntries.Count > 0) { <span class="invoice-forecast">@ForecastNote(invoice)</span> }
                <span>@StatusLabel(invoice.Status)</span>
                <span class="@(invoice.RemainingBalance.IsNegative ? "invoice-credit" : string.Empty)">Em aberto: @invoice.RemainingBalance @(invoice.RemainingBalance.IsNegative ? "(crédito)" : string.Empty)</span>
                <button class="button" @onclick="() => Select(invoice)">Ver composição</button>
                <button class="button" @onclick="() => _attachmentInvoice = invoice">Anexos</button>
                @if (invoice.Status == InvoiceStatus.Open) { <button class="button" @onclick="() => Ask(invoice, false)">Fechar</button> }
                @if (invoice.Status == InvoiceStatus.Closed && !invoice.HasConfirmedPayment) { <button class="button" @onclick="() => Ask(invoice, true)">Reabrir</button> }
                @if (invoice.Status != InvoiceStatus.Paid) { <button class="button" @onclick="() => StartPayment(invoice)" disabled="@(_paying is not null)">Pagar</button> }
                @if (invoice.Status != InvoiceStatus.Paid) { <button class="button" @onclick="() => StartAdjustment(invoice)">Ajustar valor</button> }
                @if (invoice.Status == InvoiceStatus.Closed && invoice.RemainingBalance.Amount <= 0) { <button class="button" @onclick="() => _settling = invoice">Confirmar quitação</button> }
            </li>
        }
    </ul>
</section>
@if (_invoices.FirstOrDefault(x => x.CardExternalId == _selectedCard && x.Month == _selectedMonth) is { } selected)
{
    <section class="panel" aria-label="Composição da fatura">
        <h2>@selected.CardName · @selected.Month</h2>
        <p>Situação: @StatusLabel(selected.Status)</p>
        <ul class="catalog-list">
            @foreach (var entry in selected.Entries.Where(x => !IsForecast(selected, x)))
            {
                <li><span>@entry.Date.ToString("dd/MM/yyyy") · @entry.MerchantName · @entry.Classification</span>
                    <span class="numeric entry-expense">@entry.Amount</span><span>@entry.Details</span>
                    @if (entry.InstallmentNumber is not null) { <span>Parcela @entry.InstallmentNumber/@entry.InstallmentCount</span> }
                    @if (entry.RecurringEntryExternalId is not null) { <span>Recorrente</span> }
                </li>
            }
        </ul>
        @if (selected.ForecastEntries.Count > 0)
        {
            <h3>Recorrentes previstas</h3>
            <p>Ainda não cobradas: o banco só as mostra na data de cada uma. @(selected.ForecastIncluded ? "Por preferência, já estão somadas ao total." : "Por preferência, só somam ao total na data.")</p>
            <ul class="catalog-list" aria-label="Recorrentes previstas">
                @foreach (var entry in selected.ForecastEntries)
                {
                    <li><span>@entry.Date.ToString("dd/MM/yyyy") · @entry.MerchantName · @entry.Classification</span>
                        <span class="numeric invoice-forecast">@entry.Amount</span><span>@entry.Details</span><span>Recorrente · prevista</span></li>
                }
            </ul>
        }
        <p>Total: <span class="numeric">@selected.Total</span></p>
        @if (selected.ForecastEntries.Count > 0) { <p class="invoice-forecast">@ForecastNote(selected)</p> }
        <p>Cashback: @selected.CashbackTotal · Descontos: @selected.DiscountsTotal · Pagamentos: @selected.PaymentsTotal</p>
        <p class="@(selected.RemainingBalance.IsNegative ? "invoice-credit" : string.Empty)">Saldo restante: @selected.RemainingBalance @(selected.RemainingBalance.IsNegative ? "(crédito)" : string.Empty)</p>
        <InvoicePaymentHistory Invoice="selected" Accounts="_accounts" />
    </section>
}

@code {
    private IReadOnlyList<InvoiceDetails> _invoices = [];
    private IReadOnlyList<CreditCardDetails> _cards = [];
    private IReadOnlyList<AccountDetails> _accounts = [];
    private InvoiceDetails? _attachmentInvoice;
    private async Task ClosePaymentAsync() { _paying = null; await ReloadInvoicesAsync(); }
    private InvoiceDetails? _pending;
    private InvoiceDetails? _adjusting;
    private void StartAdjustment(InvoiceDetails invoice) { _pending = null; _paying = null; _settling = null; _adjusting = invoice; }
    private async Task AdjustmentConfirmedAsync() { _adjusting = null; await ReloadInvoicesAsync(); _message = "Total conferido e atualizado."; }
    private InvoiceDetails? _paying;
    private InvoiceDetails? _settling;
    private void StartPayment(InvoiceDetails invoice) { _adjusting = null; _pending = null; _settling = null; _paying = invoice; }
    private async Task PaymentConfirmedAsync() { _paying = null; await ReloadInvoicesAsync(); _message = "Pagamento confirmado."; }
    private async Task SettleAsync()
    {
        if (_busy || _settling is not { } invoice) { return; }
        _busy = true;
        try
        {
            var result = await Payments.ConfirmSettlementAsync(invoice.CardExternalId, invoice.Month);
            _message = result.Error ?? "Quitação confirmada."; _settling = null; await ReloadInvoicesAsync();
        }
        finally { _busy = false; }
    }
    private bool _reopen;
    private bool _busy;
    private string? _message;
    private Guid _cardId;
    private string _month = string.Empty;
    private string _viewMonth = string.Empty;
    private Guid? _selectedCard;
    private AccountingMonth? _selectedMonth;
    protected override async Task OnInitializedAsync()
    {
        _month = Clock.GetLocalNow().ToString("yyyy-MM", CultureInfo.InvariantCulture);
        _cards = await Accounts.GetCreditCardsAsync(false);
        _accounts = await Accounts.GetAccountsAsync(false);
        await ReloadInvoicesAsync();
    }
    private void Select(InvoiceDetails invoice) { _selectedCard = invoice.CardExternalId; _selectedMonth = invoice.Month; }
    private void Ask(InvoiceDetails invoice, bool reopen) { _adjusting = null; _paying = null; _settling = null; _pending = invoice; _reopen = reopen; }
    private void AskManualClose()
    {
        var card = _cards.FirstOrDefault(x => x.ExternalId == _cardId);
        if (card is null || !DateOnly.TryParseExact(_month + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _message = "Selecione cartão e mês válidos."; return;
        }
        var month = AccountingMonth.FromDate(date);
        Ask(_invoices.FirstOrDefault(x => x.CardExternalId == card.ExternalId && x.Month == month) ?? new(card.ExternalId, card.Name, month, Money.Zero, []), false);
    }
    private async Task ConfirmAsync()
    {
        if (_pending is not { } pending || _busy) { return; }
        _busy = true;
        try
        {
            var result = _reopen ? await Lifecycle.ReopenAsync(pending.CardExternalId, pending.Month) : await Lifecycle.CloseAsync(pending.CardExternalId, pending.Month);
            _message = result.Error ?? "Situação atualizada.";
            _pending = null;
            await ReloadInvoicesAsync();
        }
        finally { _busy = false; }
    }
    private static bool IsForecast(InvoiceDetails invoice, Ags.Finance.Modules.Transactions.Contracts.EntryDetails entry) => invoice.ForecastEntries.Any(x => x.ExternalId == entry.ExternalId);
    private static string ForecastNote(InvoiceDetails invoice) => invoice.ForecastIncluded
        ? $"Inclui {invoice.ForecastTotal} em recorrentes previstas."
        : $"Previsto: + {invoice.ForecastTotal} (total previsto: {invoice.ProjectedTotal})";
    private static string StatusLabel(InvoiceStatus status) => status switch { InvoiceStatus.Closed => "Fechada", InvoiceStatus.Paid => "Paga", _ => "Aberta" };
    private async Task ReloadInvoicesAsync()
    {
        if (_viewMonth.Length == 0) { _invoices = await Catalog.GetAsync(); return; }
        if (!DateOnly.TryParseExact(_viewMonth + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            _message = "Informe um mês válido para consulta."; return;
        }
        _invoices = await Catalog.GetMonthAsync(AccountingMonth.FromDate(date));
    }
}
