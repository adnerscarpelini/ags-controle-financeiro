@page "/pendentes"
@using System.Globalization
@using Ags.Finance.Modules.Accounts.Contracts
@using Ags.Finance.Modules.Preferences.Contracts
@using Ags.Finance.Modules.Transactions.Contracts
@using Ags.Finance.SharedKernel
@inject IEntryCatalog Entries
@inject IAccountCatalog Accounts
@inject TimeProvider Clock
@inject IPreferences Preferences

<PageHeader Title="Lançamentos pendentes" />
<p>Receitas a receber e despesas a pagar fora do cartão. A data prevista não registra baixa automaticamente.</p>
@if (_message is not null) { <p role="status">@_message</p> }
@if (_selected is { } selected)
{
    <EffectiveEntryDialog @key="selected.ExternalId" Entry="selected" Confirmed="ConfirmedAsync" Cancelled="() => _selected = null" />
}
<section class="panel">
    <h2>Filtrar pendências</h2>
    <form id="pending-filters" @onsubmit="ApplyAsync" @onsubmit:preventDefault>
        <div class="catalog-fields">
            <div class="field"><label for="pending-account">Conta</label><select id="pending-account" @bind="_account">
                <option value="@Guid.Empty">Todas</option>@foreach (var account in _accounts) { <option value="@account.ExternalId">@account.Name @(!account.IsActive ? "(arquivada)" : string.Empty)</option> }
            </select></div>
            <div class="field"><label for="pending-kind">Tipo</label><select id="pending-kind" @bind="_kind">
                <option value="">Receitas e despesas</option><option value="@CategoryKind.Income">Receita</option><option value="@CategoryKind.Expense">Despesa</option>
            </select></div>
            <div class="field"><label for="pending-from">Data prevista de</label><input id="pending-from" type="date" @bind="_from" /></div>
            <div class="field"><label for="pending-to">Data prevista até</label><input id="pending-to" type="date" @bind="_to" /></div>
            <div class="field"><label for="pending-month">Mês de referência</label><input id="pending-month" type="month" value="@_month" @onchange="args => _month = args.Value?.ToString() ?? string.Empty" /></div>
            <div class="field"><label for="pending-text">Descrição ou detalhes</label><input id="pending-text" @bind="_text" maxlength="200" /></div>
        </div>
        <button class="button" disabled="@_busy">Filtrar</button>
        <button class="button" type="button" @onclick="ClearAsync" disabled="@_busy">Limpar filtros</button>
    </form>
</section>
<section class="panel">
    <h2>Pendências por data prevista</h2>
    @if (_busy) { <p aria-live="polite">Consultando…</p> }
    <ul class="catalog-list" aria-label="Lançamentos pendentes">@foreach (var entry in _result.Entries)
    {
        <li><span>@entry.Date.ToString("dd/MM/yyyy") · @Timing(entry.Date) · @(entry.Kind == CategoryKind.Income ? "Receita a receber" : "Despesa a pagar")</span>
            <span>@entry.MerchantName · @AccountName(entry.AccountExternalId) · @entry.Classification</span>
            <span class="numeric @(entry.Amount.IsNegative ? "entry-expense" : "entry-income")">@(entry.Amount.IsNegative ? string.Empty : "+")@entry.Amount</span>
            @if (entry.RecurringEntryExternalId is not null) { <span>Recorrência @entry.RecurringEntryExternalId</span> }
            <button class="button" @onclick="() => _selected = entry" disabled="@_busy">@(entry.Kind == CategoryKind.Expense ? "Pagar" : "Receber")</button></li>
    }</ul>
    @if (_result.TotalCount == 0 && !_busy) { <p>Nenhuma pendência neste filtro.</p> }
    <footer aria-label="Totais das pendências">
        <p>A receber: @_result.Income · A pagar: @_result.Expenses · Previsão líquida: @_result.Balance</p>
        <p>@_result.TotalCount pendências · Página @_result.Page de @_result.TotalPages</p>
        <button class="button" @onclick="() => ReloadAsync(_result.Page - 1)" disabled="@(_busy || _result.Page <= 1)">Anterior</button>
        <button class="button" @onclick="() => ReloadAsync(_result.Page + 1)" disabled="@(_busy || _result.Page >= _result.TotalPages)">Próxima</button>
    </footer>
</section>

@code {
    private IReadOnlyList<AccountDetails> _accounts = [];
    private int _pageSize = AppPreferences.Default.PageSize;
    private EntryQueryResult _result = new([], Money.Zero, Money.Zero, Money.Zero, 0, 1, AppPreferences.Default.PageSize);
    private Guid _account;
    private CategoryKind? _kind;
    private DateOnly? _from;
    private DateOnly? _to;
    private string _month = string.Empty;
    private string _text = string.Empty;
    private DateOnly _today;
    private bool _busy;
    private string? _message;
    private EntryDetails? _selected;
    protected override async Task OnInitializedAsync() { _pageSize = (await Preferences.GetAsync()).PageSize; await ReloadAsync(1); }
    private string Timing(DateOnly date) => date < _today ? "Atrasado" : date == _today ? "Hoje" : "Futuro";
    private string AccountName(Guid id)
    {
        var account = _accounts.FirstOrDefault(x => x.ExternalId == id);
        return account is null ? "Conta registrada" : account.Name + (!account.IsActive ? " (arquivada)" : string.Empty);
    }
    private Task ApplyAsync() => ReloadAsync(1);
    private async Task ReloadAsync(int page)
    {
        if (_busy) { return; }
        ReferenceMonth? month = null;
        if (_month.Length > 0)
        {
            if (!DateOnly.TryParseExact(_month + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
            {
                _message = "Informe um mês de referência válido."; return;
            }
            month = ReferenceMonth.FromDate(parsed);
        }
        _busy = true;
        try
        {
            _today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
            _accounts = await Accounts.GetAccountsAsync(false);
            var result = await Entries.QueryPendingAsync(new(month, _from, _to, _account == Guid.Empty ? null : _account, Text: _text, Kind: _kind, Page: page, PageSize: _pageSize));
            _message = result.Error;
            if (result.Error is null) { _result = result; }
        }
        finally { _busy = false; }
    }
    private async Task ConfirmedAsync() { _selected = null; await ReloadAsync(_result.Page); _message ??= "Baixa registrada."; }
    private async Task ClearAsync() { _account = Guid.Empty; _kind = null; _from = null; _to = null; _month = string.Empty; _text = string.Empty; await ReloadAsync(1); }
}
