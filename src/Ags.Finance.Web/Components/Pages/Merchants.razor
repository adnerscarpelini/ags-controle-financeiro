@page "/cadastros/descricoes"
@using Ags.Finance.Modules.Imports.Contracts
@using Ags.Finance.Modules.Transactions.Contracts
@using Ags.Finance.Web.Components.Layout
@using Ags.Finance.Web.Components.Registries
@inject IMerchantCatalog Catalog
@inject IClassificationCatalog Classifications
@inject IDialogService Dialogs
@inject ViewportState Viewport
@inject ISnackbar Snackbar

<RegistryPage TItem="MerchantDetails" Title="Descrições" Help="Nomes usados nos lançamentos. Podem sugerir uma subcategoria." NewLabel="Nova descrição" OnNew="() => OpenAsync(null)"
              Search="@_search" SearchChanged="SearchChangedAsync" Items="_merchants" Loaded="_loaded" Message="@_message" OnExternalChange="ReloadAsync" EmptyIcon="@Icons.Material.Outlined.Label" EmptyMessage="Nenhuma descrição ainda. Cadastre a primeira ou crie durante um lançamento.">
    <MoreActions><RegistryCsvMenu Kinds="s_kinds" /></MoreActions>
    <Columns>
        <MudTh><MudTableSortLabel T="MerchantDetails" SortBy="x => x.Name" InitialDirection="SortDirection.Ascending">Descrição</MudTableSortLabel></MudTh>
        <MudTh>Subcategoria padrão</MudTh>
        <MudTh>Situação</MudTh>
        <MudTh>Ações</MudTh>
    </Columns>
    <Row Context="item">
        <MudTd DataLabel="Descrição"><span class="row-title">@item.Name</span></MudTd>
        <MudTd DataLabel="Subcategoria padrão">@SubcategoryLabel(item)</MudTd>
        <MudTd DataLabel="Situação">@(item.IsActive ? "Ativa" : "Desativada")</MudTd>
        <MudTd DataLabel="Ações" Class="col-actions"><RowActions Actions="ActionsFor(item)" /></MudTd>
    </Row>
</RegistryPage>

@code {
    private static readonly RegistryKind[] s_kinds = [RegistryKind.Merchants];
    private IReadOnlyList<MerchantDetails> _merchants = [];
    private IReadOnlyList<SubcategoryDetails> _subcategories = [];
    private string _search = string.Empty;
    private string? _message;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        _subcategories = await Classifications.GetSubcategoriesAsync(false);
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _merchants = await Catalog.FindAsync(_search, false);
        _loaded = true;
    }

    private async Task ReloadAndRenderAsync()
    {
        await ReloadAsync();
        StateHasChanged();
    }

    private async Task SearchChangedAsync(string search)
    {
        _search = search;
        await ReloadAsync();
    }

    private string SubcategoryLabel(MerchantDetails item) =>
        _subcategories.FirstOrDefault(x => x.ExternalId == item.DefaultSubcategoryExternalId)?.DisplayName.Replace(" > ", " › ", StringComparison.Ordinal) ?? "Sem padrão";

    private IReadOnlyList<RowAction> ActionsFor(MerchantDetails item)
    {
        var actions = new List<RowAction> { new("Editar", Icons.Material.Outlined.Edit, "edit", EventCallback.Factory.Create(this, () => OpenAsync(item))) };
        actions.Add(new("Mesclar com outra", Icons.Material.Outlined.CallMerge, "merge", EventCallback.Factory.Create(this, () => OpenMergeAsync(item)), "Transfere os lançamentos para outra descrição e remove esta"));
        if (item.IsActive) { actions.Add(new("Excluir ou desativar", Icons.Material.Outlined.Delete, "delete", EventCallback.Factory.Create(this, () => AskDeactivationAsync(item)))); }
        return actions;
    }

    private async Task OpenAsync(MerchantDetails? item)
    {
        var parameters = new DialogParameters<MerchantDialog> { { x => x.Merchant, item }, { x => x.Saved, EventCallback.Factory.Create(this, ReloadAndRenderAsync) } };
        await Dialogs.ShowAsync<MerchantDialog>(item is null ? "Nova descrição" : "Editar descrição", parameters, AppDialogs.Options(Viewport, MaxWidth.ExtraSmall));
    }

    private async Task OpenMergeAsync(MerchantDetails item)
    {
        var parameters = new DialogParameters<MerchantMergeDialog> { { x => x.Source, item }, { x => x.Saved, EventCallback.Factory.Create(this, ReloadAndRenderAsync) } };
        await Dialogs.ShowAsync<MerchantMergeDialog>("Mesclar descrições", parameters, AppDialogs.Options(Viewport, MaxWidth.ExtraSmall));
    }

    private async Task AskDeactivationAsync(MerchantDetails item)
    {
        if (!await ConfirmDialog.AskAsync(Dialogs, "Excluir ou desativar", $"{item.Name}: desativar preserva os lançamentos e retira a descrição das novas seleções.", "Desativar", destructive: true)) { return; }
        var result = await Catalog.DeactivateAsync(item.ExternalId);
        _message = result.Error;
        if (result.Succeeded) { Snackbar.Add("Descrição desativada.", Severity.Success); }
        await ReloadAsync();
    }
}
