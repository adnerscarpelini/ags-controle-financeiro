@using Ags.Finance.Web.Authentication
@inject NavigationManager Navigation

@code {
    /// <summary>
    /// A sessão acabou com a tela aberta (senha trocada em outro lugar, por exemplo). Recarrega a página inteira
    /// para o login, que é uma página sem circuito, e depois do login volta para onde estava.
    /// </summary>
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"{AuthenticationSetup.LoginPath}?ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
