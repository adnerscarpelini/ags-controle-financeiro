@* Cashback e descontos: abatimentos reduzem o saldo restante, sem gerar receita, despesa ou débito em conta. *@
@using System.Globalization
@using Ags.Finance.Modules.Accounts.Contracts
@using Ags.Finance.Modules.Invoices.Contracts
@using Ags.Finance.SharedKernel
@inject Ags.Finance.Web.Components.Layout.ViewportState Viewport
@inject IInvoicePaymentCatalog Payments
@inject IInvoiceCatalog Invoices
@inject IAccountCatalog Accounts
@inject TimeProvider Clock
@inject EntryChangeNotifier Notifier
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudDialog Class="app-dialog">
    <DialogContent>
        @if (_error is not null) { <p class="form-error" role="alert" data-entry-error>@_error</p> }
        <h3>@(_editing is null ? "Novo cashback ou desconto" : "Editar abatimento")</h3>
        <p class="form-note">Abatimentos reduzem o saldo restante, sem gerar receita, despesa ou débito em conta. Faturas Pagas bloqueiam criação, edição e exclusão.</p>
        <form id="allowance-form" class="catalog-fields" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <div class="field"><label for="allowance-card">Cartão</label><select id="allowance-card" class="input" @bind="_card"><option value="@Guid.Empty">Selecione</option>
                @foreach (var card in _cards.Where(x => _available.Contains(x.ExternalId) || x.ExternalId == _originalCard)) { <option value="@card.ExternalId">@card.Name</option> }
            </select></div>
            <div class="field"><label for="allowance-month">Mês da fatura</label><input id="allowance-month" class="input" type="month" value="@_month" @onchange="args => _month = args.Value?.ToString() ?? string.Empty" /></div>
            <div class="field"><label for="allowance-date">Data do recebimento ou abatimento</label><input id="allowance-date" class="input" type="date" @bind="_date" /></div>
            <div class="field"><label for="allowance-kind">Tipo</label><select id="allowance-kind" class="input" @bind="_kind"><option value="@InvoicePaymentKind.Cashback">Cashback</option><option value="@InvoicePaymentKind.Discount">Desconto</option></select></div>
            <MoneyField Id="allowance-amount" Label="Valor" @bind-Value="_amount" />
            <div class="field"><label for="allowance-details">Detalhes</label><input id="allowance-details" class="input" maxlength="1000" @bind="_details" /></div>
        </form>
        <div class="filters-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" form="allowance-form" data-save Disabled="@_busy">Salvar abatimento</MudButton>
            <MudButton data-reset Disabled="@_busy" OnClick="Reset">Limpar</MudButton>
        </div>
        <h3>Histórico anual</h3>
        <form id="cashback-filter" class="catalog-fields" @onsubmit="ReloadAsync" @onsubmit:preventDefault>
            <div class="field"><label for="cashback-year">Ano do recebimento</label><input id="cashback-year" class="input" type="number" inputmode="numeric" min="1" max="9999" @bind="_year" @bind:after="ReloadAsync" /></div>
            <div class="field"><label for="cashback-card">Cartão</label><select id="cashback-card" class="input" @bind="_filterCard" @bind:after="ReloadAsync"><option value="@Guid.Empty">Todos</option>@foreach (var card in _cards) { <option value="@card.ExternalId">@card.Name</option> }</select></div>
        </form>
        <p data-cashback-total>Total de cashback recebido em @_year: <span class="numeric">@(new Money(_history.Where(x => x.Kind == InvoicePaymentKind.Cashback).Sum(x => x.Amount.Amount)))</span></p>
        <ul class="catalog-list" aria-label="Cashback por cartão">
            @foreach (var card in _history.Where(x => x.Kind == InvoicePaymentKind.Cashback).GroupBy(x => x.CardExternalId))
            {
                <li class="list-row"><span>@CardName(card.Key)</span><span class="numeric">@(new Money(card.Sum(x => x.Amount.Amount)))</span></li>
            }
        </ul>
        <MudTable T="InvoicePaymentDetails" Items="_history" Elevation="0" Class="data-table" Breakpoint="AppTables.Breakpoint(Viewport.IsMobile)" aria-label="Histórico de abatimentos">
            <HeaderContent>
                <MudTh>Data</MudTh>
                <MudTh>Cartão e fatura</MudTh>
                <MudTh>Tipo</MudTh>
                <MudTh Class="numeric">Valor</MudTh>
                <MudTh>Ações</MudTh>
            </HeaderContent>
            <RowTemplate Context="item">
                <MudTd DataLabel="Data">@item.Date.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Cartão e fatura">@CardName(item.CardExternalId) · Fatura @item.Month @if (item.Details.Length > 0) { <span class="row-note">@item.Details</span> }</MudTd>
                <MudTd DataLabel="Tipo">@TypeLabel(item.Kind)</MudTd>
                <MudTd DataLabel="Valor" Class="numeric">@item.Amount</MudTd>
                <MudTd DataLabel="Ações" Class="col-actions">
                    @if (_invoices.Any(x => x.CardExternalId == item.CardExternalId && x.Month == item.Month && x.Status == InvoiceStatus.Paid))
                    {
                        <span class="row-note" data-allowance-protected>Fatura Paga · abatimento protegido</span>
                    }
                    else
                    {
                        <RowActions Actions="ActionsFor(item)" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Icon="@Icons.Material.Outlined.Savings" Message="Nenhum abatimento neste ano." />
            </NoRecordsContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton data-dialog-done OnClick="() => Dialog?.Close(DialogResult.Ok(true))">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    /// <summary>Quando aberta do detalhe da fatura, já vem com o cartão e o mês.</summary>
    [Parameter]
    public Guid? CardExternalId { get; set; }

    [Parameter]
    public ReferenceMonth? Month { get; set; }

    private IReadOnlyList<CreditCardDetails> _cards = [];
    private HashSet<Guid> _available = [];
    private IReadOnlyList<InvoicePaymentDetails> _history = [];
    private IReadOnlyList<InvoiceDetails> _invoices = [];
    private Guid _card;
    private Guid? _originalCard;
    private Guid _filterCard;
    private Guid _confirmation = Guid.CreateVersion7();
    private Guid? _editing;
    private DateOnly _date;
    private string _month = string.Empty;
    private InvoicePaymentKind _kind = InvoicePaymentKind.Cashback;
    private decimal _amount;
    private string _details = string.Empty;
    private int _year;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _date = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        _year = _date.Year;
        _month = (Month?.FirstDay ?? _date).ToString("yyyy-MM", CultureInfo.InvariantCulture);
        _card = CardExternalId ?? Guid.Empty;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _cards = await Accounts.GetCreditCardsAsync(false);
        _available = (await Accounts.GetCreditCardsAsync()).Select(x => x.ExternalId).ToHashSet();
        _history = (await Payments.GetHistoryAsync(_filterCard == Guid.Empty ? null : _filterCard, _year)).Where(x => x.Kind != InvoicePaymentKind.Payment).ToList();
        _invoices = await Invoices.GetAsync();
    }

    private IReadOnlyList<RowAction> ActionsFor(InvoicePaymentDetails item) =>
    [
        new("Editar", Icons.Material.Outlined.Edit, "edit", EventCallback.Factory.Create(this, () => Edit(item))),
        new("Excluir", Icons.Material.Outlined.Delete, "delete", EventCallback.Factory.Create(this, () => DeleteAsync(item))),
    ];

    private string CardName(Guid id) => _cards.FirstOrDefault(x => x.ExternalId == id)?.Name ?? "Cartão registrado";

    private static string TypeLabel(InvoicePaymentKind kind) => kind == InvoicePaymentKind.Cashback ? "Cashback" : "Desconto";

    private void Reset()
    {
        _editing = null;
        _originalCard = null;
        _confirmation = Guid.CreateVersion7();
        _amount = 0;
        _details = string.Empty;
    }

    private void Edit(InvoicePaymentDetails item)
    {
        _editing = item.ExternalId;
        _confirmation = item.ConfirmationId;
        _originalCard = item.CardExternalId;
        _card = item.CardExternalId;
        _date = item.Date;
        _month = item.Month.FirstDay.ToString("yyyy-MM", CultureInfo.InvariantCulture);
        _kind = item.Kind;
        _amount = item.Amount.Amount;
        _details = item.Details;
    }

    private async Task SaveAsync()
    {
        if (_busy) { return; }
        if (!DateOnly.TryParseExact(_month + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var month))
        {
            _error = "Informe um mês válido.";
            return;
        }

        _busy = true;
        try
        {
            var result = await Payments.SaveAllowanceAsync(_editing, new(_confirmation, _card, ReferenceMonth.FromDate(month), _date, new Money(_amount), _kind, _details));
            _error = result.Error;
            if (result.Succeeded)
            {
                Snackbar.Add("Abatimento salvo.", Severity.Success);
                Notifier.Notify();
                Reset();
                await ReloadAsync();
            }
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(InvoicePaymentDetails item)
    {
        if (_busy) { return; }
        if (!await ConfirmDialog.AskAsync(Dialogs, "Excluir abatimento", $"{TypeLabel(item.Kind)} · {item.Date:dd/MM/yyyy} · {item.Amount}", "Confirmar exclusão", destructive: true)) { return; }
        _busy = true;
        try
        {
            var result = await Payments.DeleteAllowanceAsync(item.ExternalId);
            _error = result.Error;
            if (result.Succeeded)
            {
                Snackbar.Add("Abatimento excluído.", Severity.Success);
                Notifier.Notify();
                Reset();
                await ReloadAsync();
            }
        }
        finally { _busy = false; }
    }
}
