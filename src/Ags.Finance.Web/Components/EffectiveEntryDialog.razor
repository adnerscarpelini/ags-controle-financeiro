@* Pagar ou receber uma pendência. Valor, data e conta valem só para esta ocorrência. *@
@using Ags.Finance.SharedKernel
@using Ags.Finance.Modules.Transactions.Contracts
@using Ags.Finance.Modules.Accounts.Contracts
@inject IEntryAttachmentCatalog Documents
@inject IEntryCatalog Entries
@inject IAccountCatalog Accounts
@inject TimeProvider Clock
@inject EntryChangeNotifier Notifier
@inject ISnackbar Snackbar

<MudDialog Class="app-dialog">
    <DialogContent>
        <div class="entry-column">
            <p class="form-note">@Entry.MerchantName · @Entry.Amount · Conta: @_accountName · Mês de referência: @Entry.Month</p>
            <p class="form-note">As alterações valem somente para este lançamento.</p>
            @if (_archived) { <p class="form-warning" role="status">A conta está arquivada. A baixa será registrada na mesma conta e continuará no histórico.</p> }
            @if (_ready)
            {
                <div class="field"><label for="effective-date">Data da baixa</label><input id="effective-date" class="input" type="date" @bind="_date" required /></div>
            }
            else { <p aria-live="polite">Carregando conta…</p> }
            <MoneyField Id="effective-amount" Label="Valor" @bind-Value="_amount" />
            <div class="field"><label for="effective-account">Conta</label><select id="effective-account" class="input" @bind="_accountId">@foreach (var account in _accounts) { <option value="@account.ExternalId">@account.Name @(!account.IsActive ? "(arquivada)" : "")</option> }</select></div>
            @if (_error is not null) { <p class="form-error" role="alert" data-entry-error>@_error</p> }
            <AttachmentPicker @ref="_picker" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton data-confirm-cancel Disabled="@_busy" OnClick="() => Dialog?.Cancel()">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" data-confirm-ok Disabled="@(_busy || !_ready)" OnClick="ConfirmAsync">@(_confirmed ? "Reenviar anexos (baixa já registrada)" : ActionText)</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    [Parameter, EditorRequired]
    public EntryDetails Entry { get; set; } = default!;

    private AttachmentPicker? _picker;
    private bool _confirmed;
    private DateOnly _date;
    private decimal _amount;
    private Guid _accountId;
    private IReadOnlyList<AccountDetails> _accounts = [];
    private string _accountName = string.Empty;
    private bool _archived;
    private bool _busy;
    private bool _ready;
    private string? _error;

    private string ActionText => Entry.Kind == CategoryKind.Expense ? "Pagar" : "Receber";

    protected override async Task OnInitializedAsync()
    {
        _date = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        _amount = Math.Abs(Entry.Amount.Amount);
        _accountId = Entry.AccountExternalId;
        _accounts = (await Accounts.GetAccountsAsync(false)).Where(x => x.IsActive || x.ExternalId == Entry.AccountExternalId).ToList();
        var account = _accounts.FirstOrDefault(x => x.ExternalId == Entry.AccountExternalId);
        _accountName = account?.Name ?? "Conta registrada";
        _archived = account?.IsActive == false;
        _ready = true;
    }

    private async Task ConfirmAsync()
    {
        if (_busy || !_ready) { return; }
        _busy = true;
        try
        {
            var result = _confirmed ? new ClassificationResult(Entry.ExternalId, null) : await Entries.ConfirmEffectiveAsync(Entry.ExternalId, new ConfirmEffectiveRequest(_date, new Money(_amount), _accountId));
            _error = result.Error;
            if (result.Succeeded)
            {
                _confirmed = true;
                Notifier.Notify();
                if (_picker is not null && !await _picker.SendAsync((kind, name, content) => Documents.UploadAsync(Entry.ExternalId, kind, name, content)))
                {
                    _error = "Baixa registrada. O documento falhou; tente enviar novamente.";
                    return;
                }

                Snackbar.Add("Baixa registrada.", Severity.Success);
                Dialog?.Close(DialogResult.Ok(true));
            }
        }
        finally { _busy = false; }
    }
}
