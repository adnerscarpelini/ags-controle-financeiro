@* Criar ou editar uma descrição, com as parecidas já cadastradas para evitar duplicidade. *@
@using Ags.Finance.Modules.Transactions.Contracts
@inject IMerchantCatalog Catalog
@inject IClassificationCatalog Classifications
@inject ISnackbar Snackbar

<MudDialog Class="app-dialog">
    <DialogContent>
        <form id="merchant-form" class="entry-column" @onsubmit="() => SaveAsync(closeAfterSave: true)" @onsubmit:preventDefault>
            <div class="field"><label for="merchant-name">Nome</label><input id="merchant-name" class="input" maxlength="100" value="@_name" @oninput="SuggestAsync" /></div>
            @if (_suggestions.Count > 0)
            {
                <p class="form-note">Descrições parecidas já cadastradas:</p>
                <ul class="tags" aria-label="Sugestões">@foreach (var item in _suggestions) { <li class="tag">@item.Name</li> }</ul>
            }
            <div class="field">
                <label for="merchant-subcategory">Subcategoria padrão (opcional) <HelpTip Text="Sugerida ao escolher esta descrição em um lançamento. Continua editável." /></label>
                <select id="merchant-subcategory" class="input" @bind="_subcategory">
                    <option value="@Guid.Empty">Sem padrão</option>
                    @foreach (var item in _subcategories) { <option value="@item.ExternalId">@item.DisplayName.Replace(" > ", " › ", StringComparison.Ordinal)</option> }
                </select>
            </div>
        </form>
        @if (_error is not null) { <p class="form-error" role="alert" data-entry-error>@_error</p> }
        @if (_success is not null) { <p class="form-success" role="status" data-entry-success>@_success</p> }
    </DialogContent>
    <DialogActions>
        <MudButton data-dialog-cancel Disabled="@_busy" OnClick="() => Dialog?.Cancel()">Cancelar</MudButton>
        @if (Merchant is null)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" data-save-new Disabled="@(_busy || _name.Trim().Length == 0)" OnClick="() => SaveAsync(closeAfterSave: false)">Salvar e criar novo</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" form="merchant-form" data-save Disabled="@(_busy || _name.Trim().Length == 0)">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    [Parameter]
    public MerchantDetails? Merchant { get; set; }

    [Parameter]
    public EventCallback Saved { get; set; }

    private IReadOnlyList<MerchantDetails> _suggestions = [];
    private IReadOnlyList<SubcategoryDetails> _subcategories = [];
    private string _name = string.Empty;
    private Guid _subcategory;
    private bool _busy;
    private string? _error;
    private string? _success;

    protected override async Task OnInitializedAsync()
    {
        _name = Merchant?.Name ?? string.Empty;
        _subcategory = Merchant?.DefaultSubcategoryExternalId ?? Guid.Empty;
        _subcategories = (await Classifications.GetSubcategoriesAsync(false)).Where(x => x.IsActive || x.ExternalId == _subcategory).ToList();
    }

    private async Task SuggestAsync(ChangeEventArgs args)
    {
        _name = args.Value?.ToString() ?? string.Empty;
        var search = _name;
        var suggestions = search.Length > 1 ? await Catalog.FindAsync(search, false) : [];
        if (_name == search) { _suggestions = suggestions.Where(x => x.ExternalId != Merchant?.ExternalId).ToList(); }
    }

    private async Task SaveAsync(bool closeAfterSave)
    {
        if (_busy) { return; }
        _busy = true;
        _error = null;
        _success = null;
        try
        {
            var result = await Catalog.SaveAsync(Merchant?.ExternalId, _name, _subcategory == Guid.Empty ? null : _subcategory);
            if (!result.Succeeded)
            {
                _error = result.Error;
                return;
            }

            await Saved.InvokeAsync();
            Snackbar.Add("Descrição salva.", Severity.Success);
            if (closeAfterSave)
            {
                Dialog?.Close(DialogResult.Ok(true));
                return;
            }

            _name = string.Empty;
            _subcategory = Guid.Empty;
            _suggestions = [];
            _success = "Descrição salva. Preencha a próxima.";
        }
        finally { _busy = false; }
    }
}
