@* Pagamento de fatura em dois passos. A conta vinculada vem selecionada, mas pode ser trocada; só a escolhida é debitada. *@
@using Ags.Finance.Modules.Accounts.Contracts
@using Ags.Finance.Modules.Invoices.Contracts
@using Ags.Finance.SharedKernel
@using Ags.Finance.Modules.Attachments.Contracts
@inject IInvoiceAttachmentCatalog Documents
@inject IInvoicePaymentCatalog Payments
@inject IAccountCatalog Accounts
@inject TimeProvider Clock
@inject EntryChangeNotifier Notifier
@inject ISnackbar Snackbar

<MudDialog Class="app-dialog">
    <DialogContent>
        <div class="entry-column" aria-label="Registrar pagamento de fatura">
            <p class="form-note">Saldo restante: @Invoice.RemainingBalance. O valor sai da conta escolhida. As compras já foram lançadas, então isso não cria outra despesa.</p>
            @if (Invoice.ForecastEntries.Count > 0 && !Invoice.ForecastIncluded) { <p class="form-note invoice-forecast">As recorrentes previstas (@Invoice.ForecastTotal) ainda não entram no saldo.</p> }
            @if (_error is not null) { <p class="form-error" role="alert" data-entry-error>@_error</p> }
            @if (_confirmedPayment is not null)
            {
                <p class="form-success" role="status">Pagamento confirmado e definitivo. Reenviar documentos não registra outro pagamento.</p>
            }
            else if (_confirmation is { } confirmation)
            {
                <dl class="review-list" data-payment-review>
                    <div><dt>Data</dt><dd>@confirmation.Date.ToString("dd/MM/yyyy")</dd></div>
                    <div><dt>Valor</dt><dd>@confirmation.Amount</dd></div>
                    <div><dt>Débito em</dt><dd>@_accounts.First(x => x.ExternalId == confirmation.AccountExternalId).Name</dd></div>
                </dl>
                <p class="form-warning" role="status">Este pagamento só pode ser desfeito reabrindo a fatura, o que desfaz todos os pagamentos dela e devolve os valores às contas.</p>
                <p class="form-note">@(confirmation.ConfirmSettlement ? "Confirmo também a quitação da fatura." : "Este pagamento não confirma a quitação nem fecha uma fatura Aberta.")</p>
            }
            else
            {
                <form id="invoice-payment-form" class="entry-column" @onsubmit="Review" @onsubmit:preventDefault>
                    <MoneyField Id="payment-amount" Label="Valor" @bind-Value="_amount" AutoFocus="true" />
                    <div class="field-row">
                        <div class="field"><label for="payment-date">Data do pagamento</label><input id="payment-date" class="input" type="date" @bind="_date" required /></div>
                        <div class="field">
                            <label for="payment-account">Conta corrente de débito <HelpTip Text="A conta vinculada ao cartão vem selecionada, mas pode ser trocada." /></label>
                            <select id="payment-account" class="input" @bind="_account"><option value="@Guid.Empty">Selecione</option>@foreach (var account in _accounts) { <option value="@account.ExternalId">@account.Name</option> }</select>
                        </div>
                    </div>
                    <div class="field"><label for="payment-details">Detalhes</label><input id="payment-details" class="input" maxlength="1000" @bind="_details" /></div>
                    @if (Invoice.Status == InvoiceStatus.Closed)
                    {
                        <label class="checkbox"><input id="payment-settle" type="checkbox" @bind="_settle" />Confirmo também a quitação, se o saldo após este pagamento for zero ou crédito</label>
                    }
                    @if (_amount > Invoice.RemainingBalance.Amount) { <p class="form-warning">O pagamento excede o saldo restante e gera crédito.</p> }
                </form>
            }
            <AttachmentPicker @ref="_picker" Kinds="s_kinds" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton data-dialog-cancel Disabled="@_busy" OnClick="() => Dialog?.Cancel()">@(_confirmedPayment is null ? "Cancelar" : "Fechar")</MudButton>
        @if (_confirmedPayment is not null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" data-retry-attachments Disabled="@_busy" OnClick="ConfirmAsync">Reenviar somente anexos</MudButton>
        }
        else if (_confirmation is not null)
        {
            <MudButton data-review-back Disabled="@_busy" OnClick="() => _confirmation = null">Voltar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" data-confirm-ok Disabled="@_busy" OnClick="ConfirmAsync">Confirmar pagamento</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" form="invoice-payment-form" data-review Disabled="@(_busy || !_ready)">Revisar pagamento</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private static readonly AttachmentKind[] s_kinds = [AttachmentKind.Receipt, AttachmentKind.Invoice, AttachmentKind.Other];

    [CascadingParameter]
    private IMudDialogInstance? Dialog { get; set; }

    [Parameter, EditorRequired]
    public InvoiceDetails Invoice { get; set; } = default!;

    private readonly Guid _confirmationId = Guid.CreateVersion7();
    private AttachmentPicker? _picker;
    private Guid? _confirmedPayment;
    private IReadOnlyList<AccountDetails> _accounts = [];
    private Guid _account;
    private DateOnly _date;
    private decimal _amount;
    private string _details = string.Empty;
    private bool _settle;
    private bool _busy;
    private bool _ready;
    private string? _error;
    private ConfirmInvoicePaymentRequest? _confirmation;

    protected override async Task OnInitializedAsync()
    {
        _date = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
        _amount = Math.Max(0, Invoice.RemainingBalance.Amount);
        _accounts = (await Accounts.GetAccountsAsync()).Where(x => x.Kind == AccountKind.Checking).ToList();
        var linked = (await Accounts.GetCreditCardsAsync(false)).FirstOrDefault(x => x.ExternalId == Invoice.CardExternalId)?.AccountExternalId;
        _account = _accounts.FirstOrDefault(x => x.ExternalId == linked)?.ExternalId ?? Guid.Empty;
        _ready = true;
    }

    private void Review()
    {
        if (!_ready || _busy || _confirmedPayment is not null) { return; }
        if (!_accounts.Any(x => x.ExternalId == _account))
        {
            _error = "Selecione uma conta corrente ativa.";
            return;
        }

        if (_amount <= 0)
        {
            _error = "Informe um valor maior que zero. Fatura fechada sem saldo a pagar é quitada em Confirmar quitação.";
            return;
        }

        _error = null;
        _confirmation = new(_confirmationId, Invoice.CardExternalId, Invoice.Month, _account, _date, new Money(_amount), _settle, _details);
    }

    private async Task ConfirmAsync()
    {
        if (_busy || (_confirmedPayment is null && _confirmation is null)) { return; }
        _busy = true;
        _error = null;
        try
        {
            if (_confirmedPayment is null && _confirmation is { } request)
            {
                var result = await Payments.ConfirmPaymentAsync(request);
                _error = result.Error;
                if (!result.Succeeded) { return; }
                _confirmedPayment = result.ExternalId;
                Notifier.Notify();
            }

            if (_confirmedPayment is { } paymentId && _picker is not null && !await _picker.SendAsync((kind, name, content) => Documents.UploadPaymentAsync(paymentId, kind, name, content)))
            {
                _error = "Pagamento confirmado. O anexo falhou; tente reenviar somente o documento.";
                return;
            }

            Snackbar.Add("Pagamento confirmado.", Severity.Success);
            Dialog?.Close(DialogResult.Ok(true));
        }
        finally { _busy = false; }
    }
}
