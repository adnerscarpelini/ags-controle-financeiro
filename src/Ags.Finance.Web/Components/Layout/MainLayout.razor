@inherits LayoutComponentBase

<div class="app-shell @(_drawerOpen ? "drawer-open" : null)">
    <header class="topbar">
        <button type="button" class="icon-button" aria-label="Abrir menu" aria-controls="sidebar"
                aria-expanded="@(_drawerOpen ? "true" : "false")" @onclick="ToggleDrawer">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>
        <span>AGS Finanças</span>
        <PrivacyToggle Class="icon-button privacy-toggle" />
    </header>

    <div class="scrim" @onclick="CloseDrawer"></div>

    <aside id="sidebar" class="sidebar">
        <NavMenu OnNavigate="CloseDrawer" />
    </aside>

    <main class="content">
        @Body
    </main>
</div>

@code {
    private bool _drawerOpen;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }
}
