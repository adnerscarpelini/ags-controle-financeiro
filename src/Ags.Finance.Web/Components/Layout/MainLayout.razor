@inherits LayoutComponentBase
@implements IAsyncDisposable
@using Ags.Finance.Modules.Preferences.Contracts
@using Microsoft.JSInterop
@inject IPreferences Preferences
@inject ThemeState Theme
@inject ViewportState Viewport
@inject IJSRuntime Js

@* Sem observar o sistema na biblioteca: ela trocaria a paleta sozinha e ignoraria a preferência. O modo automático é tratado em ApplyTheme. *@
<MudThemeProvider Theme="AppTheme.Instance" IsDarkMode="_isDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="app-shell">
    <MudAppBar Class="topbar" Elevation="0" Fixed="true">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Class="icon-button" aria-label="Abrir menu" aria-controls="sidebar"
                       aria-expanded="@(_drawerOpen ? "true" : "false")" OnClick="ToggleDrawer" />
        <span class="topbar-title">AGS Finanças</span>
        <PrivacyToggle Class="icon-button privacy-toggle" />
    </MudAppBar>

    <MudDrawer id="sidebar" Class="@(IsCollapsed ? "sidebar sidebar-collapsed" : "sidebar")" Elevation="0" OpenMiniOnHover="false" Breakpoint="Breakpoint.Always"
               Variant="@(Viewport.IsMobile ? DrawerVariant.Temporary : DrawerVariant.Mini)"
               Open="@(Viewport.IsMobile ? _drawerOpen : !_collapsed)" OpenChanged="DrawerOpenChanged">
        <NavMenu OnNavigate="CloseDrawer" Collapsed="IsCollapsed" CanCollapse="@(!Viewport.IsMobile)" OnToggleCollapsed="ToggleCollapsedAsync" />
    </MudDrawer>

    <MudMainContent Class="app-main">
        <main class="content">
            <CascadingValue Value="Viewport.IsMobile" Name="IsMobile">
                @Body
            </CascadingValue>
        </main>
    </MudMainContent>

    @if (Viewport.IsMobile)
    {
        <div class="new-entry-fab" data-new-entry-fab>
            <NewEntryMenu />
        </div>
    }
</MudLayout>

@code {
    private DotNetObjectReference<MainLayout>? _reference;
    private ThemePreference _theme;
    private bool _isDarkMode = true;
    private bool _systemIsDark = true;
    private bool _drawerOpen;
    private bool _collapsed;

    private bool IsCollapsed => !Viewport.IsMobile && _collapsed;

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += ThemeChanged;
        Viewport.Changed += ViewportStateChanged;
        _theme = (await Preferences.GetAsync()).Theme;
        _isDarkMode = _theme != ThemePreference.Light;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _reference = DotNetObjectReference.Create(this);
        Viewport.Set(await Js.InvokeAsync<bool>("agsViewport.watch", _reference));
        _collapsed = await Js.InvokeAsync<bool>("agsMenu.isCollapsed");
        _systemIsDark = await Js.InvokeAsync<bool>("agsTheme.watchSystem", _reference);
        ApplyTheme();
    }

    [JSInvokable]
    public void ViewportChanged(bool isMobile) => Viewport.Set(isMobile);

    private void ThemeChanged(ThemePreference theme)
    {
        _theme = theme;
        _ = InvokeAsync(ApplyTheme);
    }

    [JSInvokable]
    public void SystemThemeChanged(bool isDark)
    {
        _systemIsDark = isDark;
        _ = InvokeAsync(ApplyTheme);
    }

    private void ApplyTheme()
    {
        _isDarkMode = _theme switch
        {
            ThemePreference.Light => false,
            ThemePreference.Auto => _systemIsDark,
            _ => true,
        };
        StateHasChanged();
    }

    private void ViewportStateChanged()
    {
        _drawerOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void CloseDrawer() => _drawerOpen = false;

    private async Task ToggleCollapsedAsync()
    {
        _collapsed = !_collapsed;
        await Js.InvokeVoidAsync("agsMenu.setCollapsed", _collapsed);
    }

    private void DrawerOpenChanged(bool open)
    {
        if (Viewport.IsMobile)
        {
            _drawerOpen = open;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Theme.Changed -= ThemeChanged;
        Viewport.Changed -= ViewportStateChanged;
        if (_reference is null)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("agsViewport.unwatch", _reference);
            await Js.InvokeVoidAsync("agsTheme.unwatchSystem", _reference);
        }
        catch (JSDisconnectedException)
        {
            // O circuito já caiu: o navegador descartou o ouvinte junto com a página.
        }

        _reference.Dispose();
    }
}
