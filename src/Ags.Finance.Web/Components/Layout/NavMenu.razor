<a class="brand" href="" @onclick="OnNavigate">
    <img src="img/favicon.png" alt="" width="32" height="32" />
    <span>AGS Finanças</span>
</a>

<nav aria-label="Principal">
    <ul class="nav-list">
        @foreach (var item in s_items)
        {
            <li>
                <NavLink class="nav-link" href="@item.Href" @onclick="OnNavigate">
                    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="@item.IconPath" />
                    </svg>
                    <span>@item.Label</span>
                </NavLink>
            </li>
        }
    </ul>
</nav>

<form class="nav-footer" method="post" action="/account/sign-out">
    <AntiforgeryToken />
    <button type="submit" class="nav-button">
        <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
        </svg>
        <span>Sair</span>
    </button>
</form>

@code {
    private sealed record MenuItem(string Href, string Label, string IconPath);

    private static readonly MenuItem[] s_items =
    [
        new("lancamentos", "Lançamentos", "M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"),
        new("pendentes", "Pendentes", "M12 8v4l3 2M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z"),
        new("transferencias", "Transferências e saldos", "M4 7h16M16 3l4 4-4 4M20 17H4M8 13l-4 4 4 4"),
        new("faturas", "Faturas", "M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zM2 10h20"),
        new("cashback", "Cashback", "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v10M15 9.5c0-1-1.3-1.5-3-1.5s-3 .7-3 2 1.3 1.7 3 2 3 .9 3 2-1.3 2-3 2-3-.5-3-1.5"),
        new("reembolsos", "Reembolsos", "M3 7v6h6M3 13a9 9 0 1 0 3-7.7L3 8"),
        new("dashboard", "Dashboard", "M3 3h7v9H3zM14 3h7v5h-7zM14 12h7v9h-7zM3 16h7v5H3z"),
        new("cadastros", "Cadastros", "M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8zM7.5 6.5h.01"),
        new("configuracoes", "Configurações", "M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"),
    ];

    /// <summary>Chamado ao navegar, para o layout fechar a gaveta no celular.</summary>
    [Parameter]
    public EventCallback OnNavigate { get; set; }
}
