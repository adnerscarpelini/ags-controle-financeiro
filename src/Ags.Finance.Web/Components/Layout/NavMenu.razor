@* Os links não usam o OnClick do MudNavLink: com ele a biblioteca troca o <a href> por uma div, e o item deixa de ser um link. *@
@implements IDisposable
@inject NavigationManager Navigation

<a class="brand" href="" @onclick="OnNavigate" aria-label="AGS Finanças">
    <img src="img/favicon.png" alt="" width="32" height="32" />
    @if (!Collapsed)
    {
        <span>AGS Finanças</span>
    }
</a>

<NewEntryMenu Collapsed="Collapsed" OnChosen="OnNavigate" />

<nav aria-label="Principal" class="nav-tree">
    <MudNavMenu>
        @foreach (var item in s_items)
        {
            if (item.Children is { } children)
            {
                var inGroup = IsInGroup(item);
                if (Collapsed)
                {
                    <MudTooltip Text="@item.Label" Placement="Placement.Right" RootClass="nav-tooltip">
                        <MudMenu Icon="@item.Icon" AriaLabel="@item.Label" Class="@(inGroup ? "nav-group-collapsed active" : "nav-group-collapsed")"
                                 AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopLeft">
                            @foreach (var child in children)
                            {
                                <MudMenuItem Href="@child.Href">@child.Label</MudMenuItem>
                            }
                        </MudMenu>
                    </MudTooltip>
                }
                else
                {
                    <MudNavGroup Title="@item.Label" Icon="@item.Icon" Expanded="@IsExpanded(item)" ExpandedChanged="expanded => SetExpanded(item, expanded)" Class="nav-group">
                        @foreach (var child in children)
                        {
                            <div class="nav-item" @onclick="OnNavigate"><MudNavLink Href="@child.Href" Match="NavLinkMatch.All" Class="nav-link"><span>@child.Label</span></MudNavLink></div>
                        }
                    </MudNavGroup>
                }
            }
            else if (Collapsed)
            {
                <MudTooltip Text="@item.Label" Placement="Placement.Right" RootClass="nav-tooltip">
                    <MudNavLink Href="@item.Href" Icon="@item.Icon" Match="NavLinkMatch.All" Class="nav-link"><span class="visually-hidden">@item.Label</span></MudNavLink>
                </MudTooltip>
            }
            else
            {
                <div class="nav-item" @onclick="OnNavigate"><MudNavLink Href="@item.Href" Icon="@item.Icon" Match="NavLinkMatch.All" Class="nav-link"><span>@item.Label</span></MudNavLink></div>
            }
        }
    </MudNavMenu>
</nav>

<form class="nav-footer" method="post" action="/account/sign-out">
    <AntiforgeryToken />
    <MudTooltip Text="@HideValuesTooltip" Placement="Placement.Right" Disabled="@(!Collapsed)" RootClass="nav-tooltip">
        <PrivacyToggle Class="nav-button" ShowLabel="@(!Collapsed)" />
    </MudTooltip>
    @if (CanCollapse)
    {
        <MudTooltip Text="@ToggleText" Placement="Placement.Right" Disabled="@(!Collapsed)" RootClass="nav-tooltip">
            <button type="button" class="nav-button" data-toggle-menu aria-label="@ToggleText" aria-expanded="@(Collapsed ? "false" : "true")" @onclick="OnToggleCollapsed">
                <MudIcon Icon="@(Collapsed ? Icons.Material.Outlined.ChevronRight : Icons.Material.Outlined.ChevronLeft)" Size="Size.Small" aria-hidden="true" />
                @if (!Collapsed)
                {
                    <span>@ToggleText</span>
                }
            </button>
        </MudTooltip>
    }
    <MudTooltip Text="Sair" Placement="Placement.Right" Disabled="@(!Collapsed)" RootClass="nav-tooltip">
        <button type="submit" class="nav-button" aria-label="Sair">
            <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" aria-hidden="true" />
            @if (!Collapsed)
            {
                <span>Sair</span>
            }
        </button>
    </MudTooltip>
</form>

@code {
    private const string HideValuesTooltip = "Ocultar ou mostrar os valores nesta tela";

    private sealed record MenuItem(string Label, string Icon, string Href = "", IReadOnlyList<MenuItem>? Children = null);

    private static readonly MenuItem[] s_items =
    [
        new("Dashboard", Icons.Material.Outlined.Home, "dashboard"),
        new("Lançamentos", Icons.Material.Outlined.List, "lancamentos"),
        new("Contas", Icons.Material.Outlined.AccountBalance, "cadastros/contas-cartoes"),
        new("Cartões", Icons.Material.Outlined.CreditCard, "faturas"),
        new("Planejamento", Icons.Material.Outlined.Flag, "planejamento"),
        new("Relatórios", Icons.Material.Outlined.BarChart, "relatorios/visao-19-meses"),
        new("Reembolsos", Icons.Material.Outlined.Replay, "reembolsos"),
        new("Cadastros", Icons.Material.Outlined.Folder, Children:
        [
            new("Bancos", string.Empty, "cadastros/contas-cartoes"),
            new("Categorias", string.Empty, "cadastros/categorias"),
            new("Descrições", string.Empty, "cadastros/descricoes"),
            new("Pessoas", string.Empty, "cadastros/pessoas"),
        ]),
        new("Mais opções", Icons.Material.Outlined.MoreHoriz, Children:
        [
            new("Anexos", string.Empty, "anexos"),
            new("Arquivos CSV", string.Empty, "arquivos-csv"),
            new("Backups", string.Empty, "backups"),
        ]),
        new("Configurações", Icons.Material.Outlined.Settings, "configuracoes"),
    ];

    private readonly Dictionary<string, bool> _expanded = [];

    /// <summary>Chamado ao navegar, para o layout fechar a gaveta no celular.</summary>
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    /// <summary>Menu recolhido: só ícones, com tooltip, e os grupos abrem em menu flutuante.</summary>
    [Parameter]
    public bool Collapsed { get; set; }

    /// <summary>No celular o menu é uma gaveta e não oferece recolher.</summary>
    [Parameter]
    public bool CanCollapse { get; set; } = true;

    [Parameter]
    public EventCallback OnToggleCollapsed { get; set; }

    private string ToggleText => Collapsed ? "Expandir menu" : "Recolher menu";

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += LocationChanged;
        OpenCurrentGroup();
    }

    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        OpenCurrentGroup();
        _ = InvokeAsync(StateHasChanged);
    }

    // O grupo da tela atual aparece aberto; os demais ficam como o usuário deixou.
    private void OpenCurrentGroup()
    {
        foreach (var group in s_items.Where(item => item.Children is not null))
        {
            if (IsInGroup(group))
            {
                _expanded[group.Label] = true;
            }
        }
    }

    private bool IsInGroup(MenuItem group)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return group.Children!.Any(child => string.Equals(child.Href, path, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsExpanded(MenuItem group) => _expanded.GetValueOrDefault(group.Label);

    private void SetExpanded(MenuItem group, bool expanded) => _expanded[group.Label] = expanded;

    public void Dispose() => Navigation.LocationChanged -= LocationChanged;
}
