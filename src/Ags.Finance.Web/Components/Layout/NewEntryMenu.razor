@* Botão "+ Novo", sempre visível: abre a janela do tipo escolhido, sem sair da tela atual. *@
@using Ags.Finance.Web.Components.Entries
@inject EntryDialogs Entries

<div class="new-entry" data-new-entry-menu>
    @if (Collapsed)
    {
        <MudTooltip Text="Novo" Placement="Placement.Right" RootClass="nav-tooltip">
            <MudMenu Icon="@Icons.Material.Outlined.Add" AriaLabel="Novo" Color="Color.Primary" Variant="Variant.Filled"
                     AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopLeft">
                @Options
            </MudMenu>
        </MudTooltip>
    }
    else
    {
        <MudMenu Label="Novo" StartIcon="@Icons.Material.Outlined.Add" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" RelativeWidth="DropdownWidth.Relative"
                 AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
            @Options
        </MudMenu>
    }
</div>

@code {
    [Parameter]
    public bool Collapsed { get; set; }

    [Parameter]
    public EventCallback OnChosen { get; set; }

    private RenderFragment Options => @<text>
        <MudMenuItem Icon="@Icons.Material.Outlined.ArrowDownward" IconColor="Color.Error" OnClick="() => OpenEntryAsync(EntryDialogType.Expense)">Despesa</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Outlined.ArrowUpward" IconColor="Color.Success" OnClick="() => OpenEntryAsync(EntryDialogType.Income)">Receita</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Outlined.CreditCard" IconColor="Color.Primary" OnClick="() => OpenEntryAsync(EntryDialogType.CardExpense)">Despesa cartão</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Outlined.SwapHoriz" OnClick="OpenTransferAsync">Transferência</MudMenuItem>
    </text>;

    private async Task OpenEntryAsync(EntryDialogType type)
    {
        await OnChosen.InvokeAsync();
        await Entries.ShowNewAsync(type);
    }

    private async Task OpenTransferAsync()
    {
        await OnChosen.InvokeAsync();
        await Entries.ShowTransferAsync();
    }
}
