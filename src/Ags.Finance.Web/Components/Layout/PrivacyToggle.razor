@* Alterna ocultar/mostrar valores. O comportamento é de wwwroot/js/privacy.js: aqui só o botão, que o script mantém
   sincronizado (aria-pressed, nome acessível e rótulo). A escolha é por dispositivo. *@
<button type="button" class="@Class" data-privacy-toggle aria-pressed="false" aria-label="Ocultar valores">
    <svg class="nav-icon privacy-icon-show" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z" />
    </svg>
    <svg class="nav-icon privacy-icon-hide" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M3 3l18 18M10.6 5.1A10 10 0 0 1 12 5c6 0 10 7 10 7a17 17 0 0 1-3.2 3.9M6.6 6.6A17 17 0 0 0 2 12s4 7 10 7a9.7 9.7 0 0 0 4.4-1M9.9 9.9a3 3 0 0 0 4.2 4.2" />
    </svg>
    @if (ShowLabel)
    {
        <span data-privacy-label>Ocultar valores</span>
    }
</button>

@code {
    [Parameter]
    public string Class { get; set; } = "icon-button";

    [Parameter]
    public bool ShowLabel { get; set; }
}
