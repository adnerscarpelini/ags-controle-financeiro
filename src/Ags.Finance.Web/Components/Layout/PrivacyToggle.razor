@* Alterna ocultar/mostrar valores. O comportamento é de wwwroot/js/privacy.js: aqui só o botão, que o script mantém
   sincronizado (aria-pressed, nome acessível e rótulo). A escolha é por dispositivo. *@
<button type="button" class="@Class" data-privacy-toggle aria-pressed="false" aria-label="Ocultar valores">
    <MudIcon Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" Class="privacy-icon-show" aria-hidden="true" />
    <MudIcon Icon="@Icons.Material.Outlined.VisibilityOff" Size="Size.Small" Class="privacy-icon-hide" aria-hidden="true" />
    @if (ShowLabel)
    {
        <span data-privacy-label>Ocultar valores</span>
    }
</button>

@code {
    [Parameter]
    public string Class { get; set; } = "icon-button";

    [Parameter]
    public bool ShowLabel { get; set; }
}
