  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\Ags.Finance.Modules.Attachments\Ags.Finance.Modules.Attachments.csproj" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ags.Finance.SharedKernel\Ags.Finance.SharedKernel.csproj" />
    <ProjectReference Include="..\Modules\Ags.Finance.Modules.Identity\Ags.Finance.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Ags.Finance.Modules.Accounts\Ags.Finance.Modules.Accounts.csproj" />
    <ProjectReference Include="..\Modules\Ags.Finance.Modules.Transactions\Ags.Finance.Modules.Transactions.csproj" />
    <ProjectReference Include="..\Modules\Ags.Finance.Modules.Invoices\Ags.Finance.Modules.Invoices.csproj" />
    <ProjectReference Include="..\Modules\Ags.Finance.Modules.Diagnostics\Ags.Finance.Modules.Diagnostics.csproj" />
    <ProjectReference Include="..\Modules\Ags.Finance.Modules.Preferences\Ags.Finance.Modules.Preferences.csproj" />
    <ProjectReference Include="..\Modules\Ags.Finance.Modules.Reimbursements\Ags.Finance.Modules.Reimbursements.csproj" />
    <ProjectReference Include="..\Modules\Ags.Finance.Modules.Reports\Ags.Finance.Modules.Reports.csproj" />
    <ProjectReference Include="..\Modules\Ags.Finance.Modules.Imports\Ags.Finance.Modules.Imports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ags.Finance.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../licenses/SkiaSharp/**" Link="licenses/SkiaSharp/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
