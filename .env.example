# Copie para .env (chmod 600) e preencha. O .env nunca é versionado nem vai para a imagem.
# Gere senhas fortes sem caracteres especiais, por exemplo: openssl rand -hex 24

# Senha do superusuário "postgres" (usada só em manutenção e na recuperação).
POSTGRES_PASSWORD=
# Senha do papel da aplicação (sem privilégios de superusuário), dono do banco.
AGS_DB_PASSWORD=

# Nomes e IPs do computador usados pelos dispositivos da rede, separados por vírgula.
# Entram no certificado HTTPS; ao mudar, recrie o container (o certificado é regerado).
AGS_HOST_NAMES=meu-computador,192.168.0.10

# Opcionais (valores padrão abaixo)
# AGS_VERSION=dev
# AGS_PORT=5280
# AGS_TIMEZONE=America/Sao_Paulo
# AGS_DB_NAME=ags_finance
# AGS_DB_USER=ags_app
# Backup diário automático (HH:mm no fuso da aplicação) e quantidade de backups mantidos (o mensal é sempre preservado)
# AGS_BACKUP_TIME=02:00
# AGS_BACKUP_RETENTION=30
# Pasta do host para os backups (precisa pertencer ao UID 1654, usuário "app" da imagem).
# AGS_BACKUP_DIR=./backups

# Pasta própria para anexos, previamente criada com dono UID 1654.
# AGS_ATTACHMENTS_DIR=./attachments
# Limite por arquivo (permite reduzir o teto de 20 MB).
# Attachments__MaxFileSizeMb=20
